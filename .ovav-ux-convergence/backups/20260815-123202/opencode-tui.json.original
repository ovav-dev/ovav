{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "options": {},
      "models": {}
    }
  },
  "model": "openai/gpt-5",
  "agent": {
    "primary": {
      "model": "openai/gpt-5",
      "description": "FAST — shell, autofix, quick questions"
    },
    "deep": {
      "model": "openai/gpt-5",
      "description": "DEEP — architecture, refactoring, OVAV reasoning"
    }
  },
  "command": {
    "issue": {
      "model": "openai/gpt-5",
      "description": "FAST issues"
    }
  },
  "mcp": {
    "enabled": true,
    "servers": {}
  },
  "experimental": {
    "acp": true
  },
  "share": "manual",
  "autoupdate": true,
  "default_agent": "primary"
}