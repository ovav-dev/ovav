# ─────────────────────────────────────────────────────────────
#  OVAV Starship Prompt v2 — Semantic, Compact, Premium
#  Refactored per OVAV UX Convergence 2026 spec section 21-22
#
#  Goal: immediate comprehension, semantic icons, no Powerline
#        no "on"/"is"/"via", no "v" prefix on versions.
#
#  Example target:
#    📁 ovav  🌿 develop •2  📦 2.0.0  ⬢ 24.19.0  🐍 3.14
#    ❯
# ─────────────────────────────────────────────────────────────

# ─── PALETTES (preserve Day/Night, refined) ───────────────────
[palettes.ovav-night]
brand      = '#6EA8FE'
surface    = '#111827'
success    = '#7EE787'
warning    = '#F2CC60'
danger     = '#FF6B81'
info       = '#5EEAD4'
accent     = '#C099FF'
muted      = '#4A5568'
text       = '#D8E1F0'

[palettes.ovav-day]
brand      = '#2563EB'
surface    = '#FFFFFF'
success    = '#1F7A4C'
warning    = '#8A5A00'
danger     = '#C24156'
info       = '#0F766E'
accent     = '#7C3AED'
muted      = '#94A3B8'
text       = '#1B2430'

# ─── FORMAT: single-line semantic, no Powerline, minimal ─────
format = "$directory $git_branch $git_status $character"

# ─── DIRECTORY: 📁 project/directory name (semantic) ───────────
[directory]
style = "bold $brand"
format = "[ 📁 $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

# ─── GIT BRANCH: 🌿 branch (semantic, no "on") ─────────────────
[git_branch]
symbol = "🌿 "
style = "bold $accent"
format = "[$symbol$branch]($style)"

# ─── GIT STATUS: compact dirty/stash count (no "is") ──────────
# Show only when there are changes (>$count > 0)
[git_status]
style = "$warning"
format = "[$all_status$ahead_behind]($style)"
conflicted = "⚠️${count} "
ahead = "⇡${count} "
behind = "⇣${count} "
diverged = "⇡⇣${count} "
untracked = "?${count} "
stashed = "📦${count} "
modified = "*${count} "
renamed = "»${count} "
deleted = "✘${count} "

# ─── PACKAGE: disabled (we use specific tool versions only) ──
[package]
disabled = true

# ─── NODE.JS: ⬢ hex symbol (semantic) ──────────────────────────
[nodejs]
symbol = "⬢ "
style = "bold $success"
format = "[$symbol$version]($style)"
when = "always"

# ─── PYTHON: 🐍 ────────────────────────────────────────────────
[python]
symbol = "🐍 "
style = "bold $warning"
format = "[$symbol$version]($style)"
when = "always"

# ─── GO: ⬢ overlap, use Go's gopher ────────────────────────────
[golang]
symbol = "🐹 "
style = "bold $info"
format = "[$symbol$version]($style)"
when = "always"

# ─── COMMAND DURATION: only slow commands (>5s) ───────────────
[cmd_duration]
min_time = 5_000
format = "[ ⏱ $duration ]($style)"
style = "yellow"

# ─── CHARACTER: ❯ prompt ───────────────────────────────────────
[character]
success_symbol = "[❯](bold $success)"
error_symbol = "[❯](bold $danger)"

# ─── DISABLE clutter that doesn't add value ────────────────────
[hostname]
disabled = true

[username]
disabled = true

[os]
disabled = true

[memory_usage]
disabled = true

[shell]
disabled = true

[time]
disabled = true

[rust]
disabled = true

[java]
disabled = true

[php]
disabled = true

[dotnet]
disabled = true

[env_var]
disabled = true

[kubernetes]
disabled = true

# ─── END OVAV Starship v2 ──────────────────────────────────────