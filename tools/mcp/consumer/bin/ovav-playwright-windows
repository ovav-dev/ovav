#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
readonly PS_HELPER=${OVAV_PLAYWRIGHT_PS_HELPER:-"$SCRIPT_DIR/ovav-playwright-windows.ps1"}
readonly POWERSHELL_BIN=${OVAV_POWERSHELL_BIN:-powershell.exe}
readonly WSLPATH_BIN=${OVAV_WSLPATH_BIN:-wslpath}
readonly CURL_BIN=${OVAV_CURL_BIN:-curl}
readonly NPX_BIN=${OVAV_NPX_BIN:-npx}
readonly STARTUP_TIMEOUT_SECONDS=${OVAV_STARTUP_TIMEOUT_SECONDS:-15}

chrome_pid=''
chrome_start_ticks=''
chrome_profile=''
chrome_token=''
chrome_path=''
mcp_pid=''
cleanup_started=0

log() {
  printf 'ovav-playwright-windows: %s\n' "$*" >&2
}

die() {
  log "$*"
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

parse_start_state() {
  local output=$1 key value
  while IFS='=' read -r key value; do
    value=${value%$'\r'}
    case "$key" in
      PID) chrome_pid=$value ;;
      START_TICKS) chrome_start_ticks=$value ;;
      PROFILE) chrome_profile=$value ;;
      TOKEN) chrome_token=$value ;;
      CHROME_PATH) chrome_path=$value ;;
    esac
  done <<<"$output"

  [[ $chrome_pid =~ ^[1-9][0-9]*$ ]] || die 'PowerShell returned an invalid Chrome PID'
  [[ $chrome_start_ticks =~ ^[1-9][0-9]*$ ]] || die 'PowerShell returned an invalid Chrome start time'
  [[ $chrome_token =~ ^[A-Za-z0-9-]+$ ]] || die 'PowerShell returned an invalid ownership token'
  [[ -n $chrome_profile ]] || die 'PowerShell returned an empty Chrome profile path'
  [[ -n $chrome_path ]] || die 'PowerShell returned an empty Chrome executable path'
}

cleanup() {
  local status=$?
  if ((cleanup_started)); then
    return "$status"
  fi
  cleanup_started=1

  if [[ -n $mcp_pid ]] && kill -0 "$mcp_pid" 2>/dev/null; then
    kill -TERM "$mcp_pid" 2>/dev/null || true
    wait "$mcp_pid" 2>/dev/null || true
  fi

  if [[ -n $chrome_pid ]]; then
    if ! "$POWERSHELL_BIN" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass \
      -File "$ps_helper_windows" \
      -Mode Stop \
      -ChromePid "$chrome_pid" \
      -StartTimeTicks "$chrome_start_ticks" \
      -Profile "$chrome_profile" \
      -Token "$chrome_token" \
      -ChromePath "$chrome_path" >&2; then
      log "Chrome ownership verification failed; the isolated profile was preserved"
    fi
  fi

  return "$status"
}

forward_signal() {
  local signal=$1
  if [[ -n $mcp_pid ]] && kill -0 "$mcp_pid" 2>/dev/null; then
    kill -s "$signal" "$mcp_pid" 2>/dev/null || true
  fi
}

trap cleanup EXIT
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM

[[ $STARTUP_TIMEOUT_SECONDS =~ ^[1-9][0-9]*$ ]] || die 'OVAV_STARTUP_TIMEOUT_SECONDS must be a positive integer'
[[ -f $PS_HELPER ]] || die "PowerShell helper not found: $PS_HELPER"
require_command "$POWERSHELL_BIN"
require_command "$WSLPATH_BIN"
require_command "$CURL_BIN"
require_command "$NPX_BIN"

ps_helper_windows=$($WSLPATH_BIN -w "$PS_HELPER")
ps_helper_windows=${ps_helper_windows%$'\r'}
[[ -n $ps_helper_windows ]] || die 'could not translate the PowerShell helper path'

start_output=$(
  "$POWERSHELL_BIN" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass \
    -File "$ps_helper_windows" -Mode Start
) || die 'failed to launch isolated Windows Chrome'
parse_start_state "$start_output"

profile_linux=$($WSLPATH_BIN -u "$chrome_profile")
profile_linux=${profile_linux%$'\r'}
devtools_file="$profile_linux/DevToolsActivePort"
deadline=$((SECONDS + STARTUP_TIMEOUT_SECONDS))
port=''

while ((SECONDS < deadline)); do
  if [[ -s $devtools_file ]]; then
    IFS= read -r port <"$devtools_file" || true
    port=${port%$'\r'}
    if [[ $port =~ ^[0-9]+$ ]] && ((port > 0 && port <= 65535)); then
      break
    fi
    port=''
  fi
  sleep 0.1
done

[[ -n $port ]] || die "Chrome did not publish a CDP port within ${STARTUP_TIMEOUT_SECONDS}s"
readonly cdp_endpoint="http://127.0.0.1:$port"

cdp_ready=0
while ((SECONDS < deadline)); do
  if "$CURL_BIN" --fail --silent --show-error --max-time 1 \
    "$cdp_endpoint/json/version" >/dev/null; then
    cdp_ready=1
    break
  fi
  sleep 0.1
done
((cdp_ready)) || die "Chrome CDP endpoint did not become ready within ${STARTUP_TIMEOUT_SECONDS}s"

"$NPX_BIN" -y '@playwright/mcp@0.0.79' --cdp-endpoint "$cdp_endpoint" <&0 &
mcp_pid=$!
set +e
wait "$mcp_pid"
status=$?
set -e
mcp_pid=''
exit "$status"
