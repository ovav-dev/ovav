{
  "$schema": "https://opencode.ai/config.json",
  "_ovav": {
    "autonomous": true,
    "managed_by": ".ovav/policy/permission_authority.json",
    "policy": "yolo-trusted-domain",
    "rationale": "OVAV TRUSTED DOMAIN — host does not re-ask when OVAV governor decides.",
    "version": "yolo-2026-08-13",
    "wildcard_global": true
  },
  "agent": {
    "default": {
      "description": "OVAV default agent — delegates to Platform Engineering lead",
      "mode": "primary",
      "name": "default",
      "prompt": "{file:/home/braka/Systems/ovav/.opencode/agents/area-platform-engineering.md}",
      "tools": {
        "bash": true,
        "doom_loop": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "list": true,
        "patch": true,
        "read": true,
        "skill": true,
        "task": true,
        "webfetch": true,
        "websearch": true,
        "write": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 3000,
    "tail_turns": 2
  },
  "default_agent": "Platform Engineering",
  "default_permission": "allow",
  "instructions": [
    "opencode_AGENTS.md"
  ],
  "mcp": {
    "ovav-browser": {
      "command": [
        "go",
        "run",
        "-C",
        "go-runtime",
        "./cmd/browser_server"
      ],
      "enabled": true,
      "type": "local"
    },
    "ovav-budget": {
      "enabled": false
    },
    "ovav-design-system": {
      "enabled": false
    },
    "ovav-figma": {
      "enabled": false
    },
    "ovav-git": {
      "enabled": false
    },
    "ovav-memory": {
      "command": [
        "go",
        "run",
        "-C",
        "go-runtime",
        "./cmd/memory-mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "ovav-sqlite": {
      "enabled": false
    }
  },
  "model": "openai/gpt-5.6-sol",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "\u003e:w !sudo tee": "deny",
      "apt install *": "deny",
      "apt-get install *": "deny",
      "cat /etc/passwd": "deny",
      "chmod -R 777": "deny",
      "chmod 777": "deny",
      "curl | sh": "deny",
      "dd if=/dev/zero of=/dev/sda": "deny",
      "eval $(curl": "deny",
      "gh auth login*": "deny",
      "gh auth status*": "allow",
      "gh auth token*": "deny",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh pr create*": "allow",
      "gh pr list*": "allow",
      "gh pr merge*": "deny",
      "gh pr status*": "allow",
      "gh pr view*": "allow",
      "gh release *": "deny",
      "gh repo view*": "allow",
      "git add *": "allow",
      "git branch --show-current": "allow",
      "git branch -D *": "deny",
      "git branch -d *": "deny",
      "git commit*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git ls-remote *": "allow",
      "git push --force *": "deny",
      "git push --force-with-lease *": "deny",
      "git push -f *": "deny",
      "git push*": "deny",
      "git remote -v": "allow",
      "git rev-parse*": "allow",
      "git status*": "allow",
      "go install *": "deny",
      "go run -C go-runtime ./cmd/ovav validate*": "allow",
      "go run -C go-runtime ./internal/validators/cmd/validate*": "allow",
      "mkfs": "deny",
      "nc -l -p 443 -e": "deny",
      "nmap -O": "deny",
      "npm install *": "deny",
      "npm run build*": "allow",
      "npm run lint*": "allow",
      "npm run test*": "allow",
      "npm run typecheck*": "allow",
      "npm test*": "allow",
      "pip install *": "deny",
      "pip3 install *": "deny",
      "pnpm add *": "deny",
      "pytest*": "allow",
      "python3 -c \"import pty": "deny",
      "python3 -m pytest*": "allow",
      "rm -rf /": "deny",
      "rm -rf /bin": "deny",
      "rm -rf /usr": "deny",
      "sudo *": "deny",
      "sudo su": "deny",
      "wget | sh": "deny",
      "yarn add *": "deny"
    },
    "doom_loop": "allow",
    "edit": "allow",
    "external_directory": {
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "invalid": "allow",
    "list": "allow",
    "patch": "allow",
    "question": "allow",
    "read": "allow",
    "skill": "allow",
    "task": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "write": "allow"
  },
  "plugin": [
    ".opencode/plugins/ovav-monitor.js"
  ],
  "provider": {
    "minimax-coding-plan": {
      "options": {
        "timeout": 300000
      }
    },
    "openai": {
      "options": {
        "timeout": 300000
      }
    }
  },
  "references": {
    "contracts": {
      "description": "OVAV runtime contracts — visual delivery, safe stop, context economy. Use when output format, error handling, or budget decisions are needed.",
      "hidden": true,
      "path": ".ovav/service_areas/shared"
    },
    "registry": {
      "description": "OVAV registries — active context ledger, auto triggers, capability scores. Use for state continuity and trigger-aware work.",
      "hidden": true,
      "path": ".ovav/registry"
    },
    "spec": {
      "description": "OVAV spec documents — reference for architecture, contracts, implementation plan, and authority matrix. Use before implementing or modifying governance structures.",
      "path": "docs"
    }
  },
  "small_model": "minimax-coding-plan/MiniMax-M3",
  "tool_output": {
    "max_bytes": 4096,
    "max_lines": 80
  },
  "username": "Alexander Salvador"
}
