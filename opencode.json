            "go run ./go-runtime/internal/validators/cmd/validate/*": "allow",
            "npm install *": "deny",
            "npm run build*": "allow",
            "npm run lint*": "allow",
            "npm run test*": "allow",
            "npm run typecheck*": "allow",
            "npm test*": "allow",
            "pip install *": "deny",
            "pytest*": "allow",
            "python3 -B tools/validators/*.py": "allow",
            "python3 -m pytest*": "allow",
            "python3 tools/validators/*.py": "allow",
            "rm *": "allow",
            "sudo *": "allow"
        },
        "edit": "allow",
        "external_directory": {
            "/home/braka/*": "allow",
            "/home/braka/..ovav/source/configs/wezterm/*": "allow",
            "/home/braka/.config/ovav/*": "allow",
            "/home/braka/.local/state/ovav-opencode/*": "allow",
            "/tmp/opencode/*": "allow",
            "/tmp/*": "allow",
            "/mnt/c/Users/Alexa/*": "allow",
            "/mnt/*": "allow",
            "/home/braka/Labs/mimocode/data/memory/*": "allow",
            "/home/braka/.config/opencode/*": "allow",
            "/home/braka/.config/*": "allow",
            "/home/braka/Library/**": "allow",
            "/home/braka/.ssh/*": "allow",
            "/home/braka/.gnupg/*": "allow",
            "/home/braka/.local/share/*": "allow"
