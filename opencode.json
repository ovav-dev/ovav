            "gh pr create*": "allow",
            "gh pr list*": "allow",
            "gh pr merge*": "allow",
            "gh pr status*": "allow",
            "gh pr view*": "allow",
            "gh release *": "deny",
            "gh repo view*": "allow",
            "git add *": "allow",
            "git branch --show-current": "allow",
            "git branch -d *": "allow",
            "git commit*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git ls-remote *": "allow",
            "git push --force *": "allow",
            "git push -f *": "allow",
            "git push*": "allow",
            "git remote -v": "allow",
            "git rev-parse*": "allow",
            "git status*": "allow",
