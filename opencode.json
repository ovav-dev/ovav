{
    "$schema": "https://opencode.ai/config.json",
    "agent": {},
    "compaction": {
        "auto": true,
        "preserve_recent_tokens": 3000,
        "tail_turns": 2
    },
    "default_agent": "Platform Engineering",
    "instructions": [
        "AGENTS.md"
    ],
    "mcp": {},
    "model": "opencode-go/deepseek-v4-pro",
    "permission": {
        "bash": {
            "*": "allow",
            "apt install *": "deny",
            "gh auth login*": "deny",
            "gh auth status*": "allow",
            "gh auth token*": "deny",
            "gh issue list*": "allow",
