{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "default": {
      "description": "OVAV default agent — delegates to Platform Engineering lead",
      "mode": "primary",
      "name": "default",
      "prompt": "{file:/home/braka/Systems/ovav/.opencode/agents/area-platform-engineering.md}",
      "tools": {
        "bash": true,
        "doom_loop": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "list": true,
        "patch": true,
        "read": true,
        "skill": true,
        "task": true,
        "webfetch": true,
        "websearch": true,
        "write": true
      }
    }
  },
  "default_agent": "Platform Engineering",
  "instructions": [
    "opencode_AGENTS.md"
  ],
  "mcp": {
    "atuin": {
      "enabled": false
    },
    "ovav-budget": {
      "enabled": false
    },
    "ovav-design-system": {
      "enabled": false
    },
    "ovav-fetch": {
      "enabled": false
    },
    "ovav-figma": {
      "enabled": false
    },
    "ovav-git": {
      "enabled": false
    },
    "ovav-memory": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:8932/mcp"
    },
    "ovav-playwright": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:8931/mcp"
    },
    "ovav-sqlite": {
      "enabled": false
    }
  },
  "model": "openai/gpt-5.6-luna",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "gh auth status*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh pr create*": "allow",
      "gh pr list*": "allow",
      "gh pr status*": "allow",
      "gh pr view*": "allow",
      "gh repo view*": "allow",
      "git add *": "allow",
      "git branch --show-current": "allow",
      "git commit*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git ls-remote *": "allow",
      "git remote -v": "allow",
      "git rev-parse*": "allow",
      "git status*": "allow",
      "go run -C go-runtime ./cmd/ovav validate*": "allow",
      "go run -C go-runtime ./internal/validators/cmd/validate*": "allow",
      "npm run build*": "allow",
      "npm run lint*": "allow",
      "npm run test*": "allow",
      "npm run typecheck*": "allow",
      "npm test*": "allow",
      "pytest*": "allow",
      "python3 -m pytest*": "allow"
    },
    "diff": "allow",
    "doom_loop": "allow",
    "edit": "allow",
    "external_directory": {
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "invalid": "allow",
    "list": "allow",
    "patch": "allow",
    "question": "allow",
    "read": "allow",
    "skill": "allow",
    "task": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "write": "allow"
  },
  "plugin": [
    ".opencode/plugins/ovav-monitor.js",
    ".opencode/plugins/ovav-atuin-bridge.js"
  ],
  "provider": {
    "minimax-coding-plan": {
      "options": {
        "timeout": 300000
      }
    },
    "openai": {
      "options": {
        "timeout": 300000
      }
    }
  },
  "small_model": "minimax-coding-plan/MiniMax-M3"
}
