# ~/.inputrc - OVAV readline config 2026-08-17 R10
#
# CRITICAL FIX 2026-08-17: added bindings for shift+arrow.
# Background: Microsoft Terminal v0.2.2192.0 does NOT intercept shift+arrow
# as IT-level visual selection. So the CSI sequence for shift+arrow
# reaches bash readline. With no readline binding, bash 5.x reads the
# sequence as text - the final char (A/B/C/D) gets inserted into the
# input buffer, producing the 'shift+arrow types BDAS' bug.
# Fix: bind shift+arrow CSI to a no-op (Ctrl-u Ctrl-y - kill then yank
# yields the original line). That preserves standard readline behavior
# (history-substring-search, completion) and stops the garbage input.

set editing-mode emacs
set bell-style none
set completion-ignore-case on
set show-all-if-ambiguous on
set show-all-if-unmodified on
set page-completions off
set colored-stats on
set colored-completion-prefix on
set enable-bracketed-paste on
set match-hidden-files on

"\e[A": history-substring-search-backward
"\e[B": history-substring-search-forward

"\e[1;5C": forward-word
"\e[1;5D": backward-word

"\e[1;3C": forward-word
"\e[1;3D": backward-word

"\e[1;2A": "\C-u\C-y"
"\e[1;2B": "\C-u\C-y"
"\e[1;2C": "\C-u\C-y"
"\e[1;2D": "\C-u\C-y"

"\e[H": beginning-of-line
"\e[F": end-of-line
"\e[1~": beginning-of-line
"\e[7~": beginning-of-line
"\e[4~": end-of-line
"\e[8~": end-of-line

"\e[3~": delete-char
"\e[2~": yank

"\C-x\C-x": exchange-point-and-mark
"\e[5~": history-substring-search-backward
"\e[6~": history-substring-search-forward
"\C-s": forward-search-history
