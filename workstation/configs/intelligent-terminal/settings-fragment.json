{
 "_comment": "OVAV workstation additions for Intelligent Terminal v0.2.2192+. Uses PAIRED REFERENCES (light/dark) for auto day/night. Rule #22 \u2014 Windows theme propagates to IT chrome + Starship + OpenCode.",
 "theme": {
  "light": "OVAV Day UI",
  "dark": "OVAV Night UI"
 },
 "themes": [
  {
