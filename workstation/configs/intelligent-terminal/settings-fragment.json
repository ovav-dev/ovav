 "actions": [
  {
   "name": "OVAV Workspace",
   "commandline": {
    "actions": [
     {
      "type": "newTab",
      "profile": "OVAV Ubuntu",
      "tabTitle": "OVAV \u2014 Main"
     },
     {
      "type": "splitPane",
      "split": "vertical",
      "profile": "OpenCode Ubuntu",
      "tabTitle": "Agent"
     },
     {
      "type": "splitPane",
      "split": "horizontal",
      "profile": "OVAV Ubuntu",
      "tabTitle": "Logs"
     }
    ]
   },
   "keybind": "ctrl+shift+grave"
  },
  {
   "name": "New OVAV Tab",
   "commandline": {
    "actions": [
     {
      "type": "newTab",
      "profile": "OVAV Ubuntu"
     }
    ]
   },
   "keybind": "ctrl+shift+t"
  },
  {
   "name": "OVAV Split Vertical",
   "commandline": {
    "actions": [
     {
      "type": "splitPane",
      "split": "vertical",
      "profile": "${profile.name}"
     }
    ]
   },
   "keybind": "ctrl+alt+d"
  },
  {
   "name": "OVAV Split Horizontal",
   "commandline": {
    "actions": [
     {
      "type": "splitPane",
      "split": "horizontal",
      "profile": "${profile.name}"
     }
    ]
   },
   "keybind": "ctrl+alt+s"
  },
  {
   "name": "OVAV Focus Left",
   "commandline": {
    "actions": [
     {
      "type": "moveFocus",
      "direction": "left"
     }
    ]
   },
   "keybind": "alt+left"
  },
  {
   "name": "OVAV Focus Right",
   "commandline": {
    "actions": [
     {
      "type": "moveFocus",
      "direction": "right"
     }
    ]
   },
   "keybind": "alt+right"
  },
  {
   "name": "OVAV Focus Up",
   "commandline": {
    "actions": [
     {
      "type": "moveFocus",
      "direction": "up"
     }
    ]
   },
   "keybind": "alt+up"
  },
  {
   "name": "OVAV Focus Down",
   "commandline": {
    "actions": [
     {
      "type": "moveFocus",
      "direction": "down"
     }
    ]
   },
   "keybind": "alt+down"
  },
  {
   "name": "OVAV Toggle Zoom",
   "commandline": {
    "actions": [
     {
      "type": "togglePaneZoom"
     }
    ]
   },
   "keybind": "ctrl+shift+z"
  },
  {
   "name": "OVAV Close Pane",
   "commandline": {
    "actions": [
     {
      "type": "closePane"
     }
    ]
   },
   "keybind": "ctrl+shift+w"
  },
  {
   "name": "OVAV Command Palette",
   "commandline": {
    "actions": [
     {
      "type": "commandPalette"
     }
    ]
   },
   "keybind": "ctrl+shift+p"
  },
  {
   "name": "OVAV Search",
   "commandline": {
    "actions": [
     {
      "type": "findMatch"
     }
    ]
   },
   "keybind": "ctrl+shift+f"
  }
 ],
 "tabWidthMode": "compact",
 "tabSwitcherMode": "mru",
 "newTabPosition": "afterCurrentTab",
 "initialRows": 32,
 "initialCols": 120,
 "padding": "12, 8, 12, 8",
 "focusFollowMouse": false
}