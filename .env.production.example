# OVAV cPanel — Production Environment Variables
# =============================================================================
# Copy to .env.production and fill in real values.
# NEVER commit .env.production with real secrets.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5858
OVAV_ROOT=/app

# ── OAuth (Google Cloud Console) ─────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Redirect URI: https://d678beea.ovav.dev (URL base del SPA, NO el endpoint API)
# IMPORTANTE: El SPA lee ?code= de la URL. No usar /api/v1/auth/oauth/google.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ── OAuth (GitHub Developer Settings) ────────────────────────────────────────
# https://github.com/settings/developers
# Authorization callback URL: https://d678beea.ovav.dev (URL base del SPA)
# IMPORTANTE: Misma URL que Google. El SPA lee ?code= de query params.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ── OAuth Redirect URI ───────────────────────────────────────────────────────
# Debe coincidir EXACTAMENTE con las redirect URIs registradas en Google/GitHub
OAUTH_REDIRECT_URI=https://d678beea.ovav.dev

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated admin emails
ADMIN_EMAILS=alexander@ovav.dev

# ── Email (Resend / Postmark) ────────────────────────────────────────────────
# https://resend.com — 100 emails/day free
RESEND_API_KEY=
EMAIL_FROM=cpanel@ovav.dev
