# OVAV Crusher - MiniMax Provider Configuration
# =============================================================================
# Connect your MiniMax subscription directly to OVAV
# =============================================================================

# Instructions:
# 1. Get your MiniMax API key from https://platform.minimaxi.com/
# 2. Set the environment variables below
# 3. Run: source this file OR add to your shell profile
# =============================================================================

# ═══════════════════════════════════════════════════════════════════════════════
# OPTION A: Direct MiniMax API (YOUR subscription)
# ═══════════════════════════════════════════════════════════════════════════════

# Your MiniMax API key from platform.minimaxi.com
export MINIMAX_API_KEY="your-minimax-api-key-here"

# MiniMax API endpoint (usually these work)
export MINIMAX_BASE_URL="https://api.minimaxi.chat/v1"

# Default model
export MINIMAX_MODEL="MiniMax-Text-01"

# OVAV override (takes precedence over above)
export OVAV_PROVIDER="minimax"
export OVAV_API_KEY="$MINIMAX_API_KEY"
export OVAV_BASE_URL="$MINIMAX_BASE_URL"
export OVAV_MODEL="$MINIMAX_MODEL"

# ═══════════════════════════════════════════════════════════════════════════════
# OPTION B: Via OVAV-CONNECT Go runtime (recommended for token tracking)
# ═══════════════════════════════════════════════════════════════════════════════
# OVAV-CONNECT will track your usage and costs

# Enable OVAV-CONNECT with MiniMax
export OVAV_CONNECT_ENABLED="true"

# OVAV Connect stores usage in .ovav/connect/
export OVAV_ROOT="/home/braka/Systems/OVAV"

# ═══════════════════════════════════════════════════════════════════════════════
# VERIFICATION
# ═══════════════════════════════════════════════════════════════════════════════
# After setting, run:
#   go run -C go-runtime ./cmd/connect status
#   crush models | grep minimax