  "type": "dark",
  "defs": {
    "ovav_bg": "#1a1b1e",
    "ovav_bg_raised": "#222328",
    "ovav_bg_muted": "#141518",
    "ovav_panel": "#2a2b30",
    "ovav_element": "#35363b",
    "ovav_border": "#3e4046",
    "ovav_border_subtle": "#2d2e32",
    "ovav_text": "#d4d0c8",
