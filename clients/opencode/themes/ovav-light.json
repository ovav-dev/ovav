{
  "$schema": "https://opencode.ai/theme.json",
  "name": "OVAV Light",
  "type": "light",
  "defs": {
    "ovav_bg": "#f5f2ed",
    "ovav_bg_raised": "#ffffff",
    "ovav_bg_muted": "#eae6df",
    "ovav_panel": "#ede9e2",
    "ovav_element": "#e2ddd5",
    "ovav_border": "#d4cfc5",
    "ovav_border_subtle": "#e5e0d8",
    "ovav_text": "#2d2a26",
    "ovav_text_secondary": "#5c5650",
    "ovav_text_muted": "#8a847c",
    "ovav_primary": "#5a7d8a",
    "ovav_secondary": "#7d884a",
    "ovav_accent": "#b06d78",
    "ovav_error": "#c45a4d",
    "ovav_warning": "#b08a3c",
    "ovav_success": "#5a8a5a",
    "ovav_info": "#4a7d9a",
    "ovav_syn_keyword": "#b06d78",
    "ovav_syn_string": "#7d884a",
    "ovav_syn_comment": "#8a847c",
    "ovav_syn_function": "#5a7d8a",
    "ovav_syn_type": "#b08a3c",
    "ovav_syn_variable": "#2d2a26",
    "ovav_syn_number": "#c45a4d",
    "ovav_syn_operator": "#5a8a5a",
    "ovav_diff_added": "#5a8a5a",
    "ovav_diff_removed": "#c45a4d",
    "ovav_diff_context": "#8a847c",
    "ovav_scrollbar": "#d4cfc5",
    "ovav_scrollbar_hover": "#8a847c"
  },
  "theme": {
    "primary": { "dark": "ovav_primary", "light": "ovav_primary" },
    "secondary": { "dark": "ovav_secondary", "light": "ovav_secondary" },
    "accent": { "dark": "ovav_accent", "light": "ovav_accent" },
    "error": { "dark": "ovav_error", "light": "ovav_error" },
    "warning": { "dark": "ovav_warning", "light": "ovav_warning" },
    "success": { "dark": "ovav_success", "light": "ovav_success" },
    "info": { "dark": "ovav_info", "light": "ovav_info" },
    "text": { "dark": "ovav_text", "light": "ovav_text" },
    "textMuted": { "dark": "ovav_text_muted", "light": "ovav_text_muted" },
    "textSecondary": { "dark": "ovav_text_secondary", "light": "ovav_text_secondary" },
    "background": { "dark": "ovav_bg", "light": "ovav_bg" },
    "backgroundPanel": { "dark": "ovav_panel", "light": "ovav_panel" },
    "backgroundElement": { "dark": "ovav_element", "light": "ovav_element" },
    "border": { "dark": "ovav_border", "light": "ovav_border" },
    "borderActive": { "dark": "ovav_primary", "light": "ovav_primary" },
    "borderSubtle": { "dark": "ovav_border_subtle", "light": "ovav_border_subtle" },
    "scrollbar": { "dark": "ovav_scrollbar", "light": "ovav_scrollbar" },
    "scrollbarHover": { "dark": "ovav_scrollbar_hover", "light": "ovav_scrollbar_hover" },
    "inputBackground": { "dark": "ovav_bg_raised", "light": "ovav_bg_raised" },
    "inputForeground": { "dark": "ovav_text", "light": "ovav_text" },
    "inputPlaceholder": { "dark": "ovav_text_muted", "light": "ovav_text_muted" },
    "diffAdded": { "dark": "ovav_diff_added", "light": "ovav_diff_added" },
    "diffRemoved": { "dark": "ovav_diff_removed", "light": "ovav_diff_removed" },
    "diffContext": { "dark": "ovav_diff_context", "light": "ovav_diff_context" },
    "diffAddedBg": { "dark": "#e5f0e5", "light": "#e5f0e5" },
    "diffRemovedBg": { "dark": "#f5e5e5", "light": "#f5e5e5" }
  }
}
