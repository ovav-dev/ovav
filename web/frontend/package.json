{
  "name": "ovav-web",
  "version": "1.2.0",
  "private": true,
  "description": "OVAV Product — Plataforma web pública",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:port": "next dev -p",
    
    "start": "systemctl --user start ovav-frontend",
    "stop": "systemctl --user stop ovav-frontend",
    "restart": "systemctl --user restart ovav-frontend",
    "status": "systemctl --user status ovav-frontend",
    "logs": "journalctl --user -u ovav-frontend -n 30",
    
    "build": "next build",
    "build:clean": "rm -rf .next && next build",
    "clean": "rm -rf .next out",
    
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.32.0",
    "@stripe/stripe-js": "^3.5.0",
    "autoprefixer": "^10.5.0",
    "framer-motion": "^12.40.0",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^3.2.0",
    "stripe": "^15.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.0"
  }
}
