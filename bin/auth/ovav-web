#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════
# ovav-web — OVAV web identity auth (https://d678beea.ovav.dev)
# Companion to ovav-local. Symmetric UX, browser-based OAuth flow.
# ═══════════════════════════════════════════════════════════════════
#
# Replaces: ovav login --web
# Side effects: opens default browser; polls backend
#
# Usage:
#   ovav-web                       # full flow (challenge + browser + poll)
#   ovav-web --check               # preflight only: HTTP 200 + JSON check
#   ovav-web --help
#
set -u

REPO_ROOT="${OVAV_REPO_ROOT:-/home/braka/Systems/ovav}"
OVAV_SHARE_DIR="${OVAV_SHARE_DIR:-${HOME:-/home/braka}/.local/share/ovav}"
BACKEND_URL="${OVAV_WEB_URL:-https://d678beea.ovav.dev}"
SEED_FILE_PATH="${OVAV_SHARE_DIR}/seed_export"
VAULT_KEY_PATH="${OVAV_SHARE_DIR}/vault_key_export"

if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_DN=$'\033[31m'; C_IN=$'\033[36m'; C_YL=$'\033[33m'; C_OFF=$'\033[0m'
else
  C_OK=''; C_DN=''; C_IN=''; C_YL=''; C_OFF=''
fi

log_ok()   { printf "  ${C_OK}✅ %s${C_OFF}\n" "$1"; }
log_warn() { printf "  ${C_IN}⚠️  %s${C_OFF}\n" "$1"; }
log_die()  { printf "  ${C_DN}❌ %s${C_OFF}\n" "$1" >&2; exit 1; }

usage() {
  cat <<'USAGE'
ovav-web — OVAV web identity auth (https://d678beea.ovav.dev)

USAGE:
  ovav-web              full flow: preflight → challenge → browser → poll
  ovav-web --check      preflight only (verify backend reachable + JSON)
  ovav-web --no-open    do not auto-open browser (just print URL)
  ovav-web --help       this help

ENV VARS:
  OVAV_WEB_URL       override backend (default: https://d678beea.ovav.dev)
  OVAV_SHARE_DIR     override ovav state dir for shred targets
USAGE
}

# ─── preflight: backend reachable + returns valid JSON ───────────────────
preflight() {
  echo "  ${C_IN}» preflight:${C_OFF} ${BACKEND_URL}/api/v1/auth/login-challenge-web"

  local resp_file
  resp_file=$(mktemp)
  local http_code
  http_code=$(curl -sS --max-time 10 -o "$resp_file" -w "%{http_code}" \
    -H "Accept: application/json" \
    "${BACKEND_URL}/api/v1/auth/login-challenge-web" 2>&1) || {
      rm -f "$resp_file"
      log_warn "Backend unreachable — check network"
      log_warn "  OVAV_WEB_URL=$BACKEND_URL"
      return 1
    }

  if [ "$http_code" != "200" ]; then
    log_warn "Backend returned HTTP $http_code (NOT 200) — backend may be misconfigured"
    [ -s "$resp_file" ] && head -c 400 "$resp_file" | sed 's/^/    /'
    rm -f "$resp_file"
    return 1
  fi

  # Verify JSON
  if ! command -v jq >/dev/null 2>&1; then
    if ! python3 -c "import json,sys; d=json.load(open('$resp_file')); assert 'challenge' in d" 2>/dev/null; then
      log_warn "Response not valid JSON — backend may return HTML"
      head -c 400 "$resp_file" | sed 's/^/    /'
      rm -f "$resp_file"
      return 1
    fi
  else
    if ! jq -e '.challenge' <"$resp_file" >/dev/null 2>&1; then
      log_warn "Response JSON missing 'challenge' field"
      head -c 400 "$resp_file" | sed 's/^/    /'
      rm -f "$resp_file"
      return 1
    fi
  fi

  log_ok "Backend reachable + returns valid challenge JSON"
  rm -f "$resp_file"
  return 0
}

# ─── postflight: shred any leaked exports (web flow doesn't need seed) ─
postflight_shred() {
  if [ -f "$SEED_FILE_PATH" ]; then
    shred -n 2 -z -u "$SEED_FILE_PATH" 2>/dev/null || rm -f "$SEED_FILE_PATH"
    log_ok "seed_export (leaked from prior session) shredded"
  fi
  if [ -f "$VAULT_KEY_PATH" ]; then
    shred -n 2 -z -u "$VAULT_KEY_PATH" 2>/dev/null || rm -f "$VAULT_KEY_PATH"
    log_ok "vault_key_export (leaked) shredded"
  fi
}

# ─── main ────────────────────────────────────────────────────────────────
main() {
  case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    --check)
      echo "🌐 ${C_IN}ovav-web${C_OFF} — preflight check"
      echo
      if preflight; then
        echo
        log_ok "Web backend reachable + JSON contract valid"
        exit 0
      else
        echo
        log_die "Web backend NOT ready — fix backend BEFORE running ovav-web"
      fi
      ;;
  esac

  echo "🌐 ${C_IN}ovav-web${C_OFF} — identity auth (browser-based)"
  echo

  if ! preflight; then
    echo
    log_die "Refusing to launch interactive flow on broken backend"
  fi

  echo "  ${C_IN}» launching: ovav login --web${C_OFF}"
  echo
  postflight_shred
  ovav login --web
  local rc=$?
  echo
  postflight_shred
  if [ "$rc" -eq 0 ]; then
    log_ok "Web session ready"
    ovav whoami 2>/dev/null | sed 's/^/    /'
  else
    log_warn "ovav login --web returned non-zero (rc=$rc)"
    return "$rc"
  fi
}

main "$@"
