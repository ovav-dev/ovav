#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════
# ovav-local — OVAV local identity auth (offline, seed-based)
# Companion to ovav-web. Symmetric UX, zero auto-export by default.
# ═══════════════════════════════════════════════════════════════════
#
# Replaces: ovav login --force  (auto-shreds exports after use)
# Inputs:    SEED env var OR --seed-file <path> OR TTY prompt (default)
# Outputs:   Shreds ~/.local/share/ovav/{seed,vault_key}_export after success
#
# Usage:
#   ovav-local                    # TTY prompt (most secure)
#   SEED="..." ovav-local         # pipe via env (visible in ps)
#   ovav-local --seed-file /path  # file-based (with shred pre-flight)
#
set -u

REPO_ROOT="${OVAV_REPO_ROOT:-/home/braka/Systems/ovav}"
HOME_DIR="${HOME:-/home/braka}"
OVAV_SHARE_DIR="${OVAV_SHARE_DIR:-${HOME_DIR}/.local/share/ovav}"
LOCK_REL=".ovav/registry/.identity-recovery.lock"
LOCK_PATH="${REPO_ROOT}/${LOCK_REL}"
SEED_FILE_PATH="${OVAV_SHARE_DIR}/seed_export"
VAULT_KEY_PATH="${OVAV_SHARE_DIR}/vault_key_export"

if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_DN=$'\033[31m'; C_IN=$'\033[36m'; C_OFF=$'\033[0m'
else
  C_OK=''; C_DN=''; C_IN=''; C_OFF=''
fi

log_ok()   { printf "  ${C_OK}✅ %s${C_OFF}\n" "$1"; }
log_warn() { printf "  ${C_IN}⚠️  %s${C_OFF}\n" "$1"; }
log_die()  { printf "  ${C_DN}❌ %s${C_OFF}\n" "$1" >&2; exit 1; }

# ─── preflight: stale-lock purge ─────────────────────────────────────────
preflight_stale_lock() {
  [ ! -e "$LOCK_PATH" ] && return 0
  local pid
  pid=$(awk 'NR==1{print; exit}' "$LOCK_PATH" 2>/dev/null)
  if [ -z "$pid" ]; then
    log_warn "Lock has no PID → deleting"
    rm -f "$LOCK_PATH"; return 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    log_warn "Lock held by dead PID $pid → purging"
    rm -f "$LOCK_PATH"
  else
    log_die "Lock held by alive PID $pid — another recovery is running"
  fi
}

# ─── preflight: clear any leftover exports from prior leaked sessions ───
preflight_clear_exports() {
  if [ -f "$SEED_FILE_PATH" ] || [ -f "$VAULT_KEY_PATH" ]; then
    log_warn "Pre-existing secret exports detected → pre-shredding"
    command -v shred >/dev/null && {
      [ -f "$SEED_FILE_PATH" ] && shred -n 2 -z -u "$SEED_FILE_PATH" 2>/dev/null
      [ -f "$VAULT_KEY_PATH" ] && shred -n 2 -z -u "$VAULT_KEY_PATH" 2>/dev/null
    } || {
      rm -f "$SEED_FILE_PATH" "$VAULT_KEY_PATH"
    }
  fi
}

# ─── acquire seed ────────────────────────────────────────────────────────
acquire_seed() {
  if [ -n "${SEED:-}" ]; then printf '%s' "$SEED"; return 0; fi
  if [ "${1:-}" = "--seed-file" ] && [ -n "${2:-}" ]; then
    [ -f "$2" ] || log_die "--seed-file not found: $2"
    # Shred file after reading
    local content
    content=$(awk 'NR==1{print; exit}' "$2")
    command -v shred >/dev/null && shred -n 2 -z -u "$2" 2>/dev/null || rm -f "$2"
    printf '%s' "$content"
    return 0
  fi
  return 0
}

# ─── run ovav login with the seed ───────────────────────────────────────
run_login() {
  local seed="$1"
  if [ -n "$seed" ]; then
    printf '%s\n' "$seed" | ovav login --force 2>&1
  else
    ovav login --force 2>&1
  fi
}

# ─── postflight: auto-shred any leaked exports ───────────────────────────
postflight_shred_exports() {
  local touched=0
  if [ -f "$SEED_FILE_PATH" ]; then
    shred -n 2 -z -u "$SEED_FILE_PATH" 2>/dev/null || rm -f "$SEED_FILE_PATH"
    log_ok "seed_export shredded"
    touched=1
  fi
  if [ -f "$VAULT_KEY_PATH" ]; then
    shred -n 2 -z -u "$VAULT_KEY_PATH" 2>/dev/null || rm -f "$VAULT_KEY_PATH"
    log_ok "vault_key_export shredded"
    touched=1
  fi
  [ "$touched" -eq 0 ] && log_ok "no exports leaked (clean session)"
}

# ─── main ────────────────────────────────────────────────────────────────
main() {
  case "${1:-}" in
    --help|-h)
      printf "ovav-local — OVAV local identity auth (offline, machine-bound)\n\n"
      printf "USAGE:\n"
      printf "  ovav-local                    TTY prompt (most secure)\n"
      printf "  SEED=... ovav-local           via env (visible in ps — audit only)\n"
      printf "  ovav-local --seed-file <path> file-based (auto-shred after read)\n\n"
      printf "Effects:\n"
      printf "  * Purges stale .identity-recovery.lock if held by dead PID\n"
      printf "  * Pre-shreds any leaked exports\n"
      printf "  * Runs: ovav login --force\n"
      printf "  * Post-shreds any exports created during login\n"
      exit 0
      ;;
  esac
  echo "🔐 ${C_IN}ovav-local${C_OFF} — identity auth (offline, machine-bound)"
  echo
  preflight_stale_lock
  preflight_clear_exports
  local seed
  seed=$(acquire_seed "$@")
  if [ -z "$seed" ] && [ -t 0 ]; then
    printf "  ${C_IN}» ovav will prompt for seed (hidden)${C_OFF}\n"
  fi
  echo "  ${C_IN}» running: ovav login --force${C_OFF}"
  echo
  run_login "$seed"
  local rc=$?
  echo
  postflight_shred_exports
  if [ "$rc" -eq 0 ]; then
    echo
    log_ok "Local session ready"
    ovav whoami 2>/dev/null | sed 's/^/    /'
  else
    log_warn "ovav login returned non-zero (rc=$rc)"
    return "$rc"
  fi
}

main "$@"
