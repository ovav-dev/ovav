#!/usr/bin/env bash
# ========================================================================
# ovav-commit — Intelligent commit system 2026
# Ubicación: $OVAV_ROOT/bin/ovav-commit
# ========================================================================

OVAV_CONFIG_DIR="${OVAV_CONFIG_DIR:-$HOME/.config/ovav}"
IDENTITIES_FILE="$OVAV_CONFIG_DIR/identities.json"
GITMSG_FILE="$OVAV_CONFIG_DIR/gitmessage"

# ─── Identity detection ────────────────────────────────────────────────────
detect_mode() {
    # MANUAL: TTY directo + SSH connection activa (terminal real, no agente)
    if [[ -t 0 ]] && [[ -n "$SSH_CONNECTION" ]]; then
        echo "manual"
        return 0
    fi
    echo "agent"
}

# ─── Load identity ─────────────────────────────────────────────────────────
load_identity() {
    local mode="$1"
    local lead="${OVAV_ACTIVE_LEAD:-thavren}"
    
    if [[ "$mode" == "manual" ]]; then
        python3 -c "
import json
d=json.load(open('$IDENTITIES_FILE'))
i=d['ceo']
print(i['name']); print(i['email']); print(i.get('signing_key',''))"
    else
        python3 -c "
import json
d=json.load(open('$IDENTITIES_FILE'))
i=d['leads']['$lead']
print(i['name']); print(i['email']); print(i.get('signing_key',''))"
    fi
}

# ─── Apply identity ────────────────────────────────────────────────────────
apply_identity() {
    local name="$1" email="$2" signing_key="$3"
    git config --global user.name "$name" 2>/dev/null
    git config --global user.email "$email" 2>/dev/null
    if [[ -n "$signing_key" && -f "${signing_key}.pub" ]]; then
        git config --global user.signingkey "${signing_key}.pub" 2>/dev/null
    fi
}

# ─── Add OVAV trailers ─────────────────────────────────────────────────────
add_trailers() {
    local msg_file="$1"
    local mode="$2"
    local lead="${OVAV_ACTIVE_LEAD:-thavren}"
    local ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    
    if grep -q "^OVAV-Identity:" "$msg_file" 2>/dev/null; then
        return 0
    fi
    
    printf "\nOVAV-Identity: %s\n" "$mode/$lead" >> "$msg_file"
    printf "OVAV-Hash: %s\n" "$(sha256sum "$msg_file" 2>/dev/null | cut -d' ' -f1 | cut -c1-16)" >> "$msg_file"
}

# ─── Main ──────────────────────────────────────────────────────────────────
main() {
    local mode=$(detect_mode)
    local msg=""
    local files=()

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--message) msg="$2"; shift 2 ;;
            -a|--all) files+=(-a); shift ;;
            *) files+=("$1"); shift ;;
        esac
    done

    local name email signing_key
    read -r name < <(load_identity "$mode")
    read -r email < <(load_identity "$mode")
    read -r signing_key < <(load_identity "$mode")

    echo "[ovav-commit] Identity: $name <$email> [${mode}]"
    apply_identity "$name" "$email" "$signing_key"

    if [[ -n "$msg" ]]; then
        local tmpmsg
        tmpmsg=$(mktemp)
        echo "$msg" > "$tmpmsg"
        add_trailers "$tmpmsg" "$mode"
        git commit -S "${files[@]}" -F "$tmpmsg"
        rm -f "$tmpmsg"
    else
        git commit -S -t "$GITMSG_FILE" "${files[@]}"
    fi
}

main "$@"
