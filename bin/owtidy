#!/usr/bin/env bash
# =============================================================================
# owtidy — OVAV Worktree Tidy
# v1.0.0 — All-in-one cleanup for OVAV system + consumers.
#
# Handles ALL residue scenarios in one command:
#   1. Stale stashes (auto-drop if older than threshold)
#   2. Phantom worktrees (path missing) → prune
#   3. Worktree drift (paths not in canonical locations) → report
#   4. Dirty tracked files → report
#   5. Untracked runtimes/ + .ovav/integrity/ → discard (regenerable)
#   6. Conflict markers (`<<<<<<<`) in files → report
#   7. Git lock files (stale) → clear
#   8. Git GC + repack
#   9. Consumer audit log rotation (>30 days)
#   10. Stale branches (merged or no remote) → report
#
# Modes:
#   owtidy            # default: safe cleanup + report
#   owtidy --safe     # explicit safe mode (same as default)
#   owtidy --deep     # auto-fix more aggressively (incl. stashes >7d)
#   owtidy --dry-run  # only report, no changes
#   owtidy --json     # machine-readable output
# =============================================================================
set -euo pipefail

OVAV_ROOT="${OVAV_ROOT:-/home/braka/Systems/OVAV}"
MODE="${1:-safe}"
[ "$MODE" = "--safe" ] && MODE="safe"
[ "$MODE" = "--deep" ] && MODE="deep"
[ "$MODE" = "--dry-run" ] && MODE="dry-run"
[ "$MODE" = "--json" ] && MODE="json"

STALE_DAYS_SAFE=30
STALE_DAYS_DEEP=7

# ──── Output helpers ──────────────────────────────────────────────────────────
red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
bold()   { printf '\033[1m%s\033[0m\n' "$*"; }

# State accumulators (for --json output)
ACTIONS=()
FINDINGS=()

record_action() { ACTIONS+=("$1"); }
record_finding() { FINDINGS+=("$1"); }

# ──── Pre-flight ──────────────────────────────────────────────────────────────
cd "$OVAV_ROOT" 2>/dev/null || { red "ERROR: OVAV_ROOT=$OVAV_ROOT not accessible"; exit 2; }
[ -d ".git" ] || { red "ERROR: not a git repo"; exit 2; }

DRY="false"
[ "$MODE" = "dry-run" ] && DRY="true"

if [ "$MODE" != "json" ]; then
  bold "═══════════════════════════════════════════════════════════"
  bold " owtidy v1.0.0 — mode=$MODE, dry=$DRY"
  bold "═══════════════════════════════════════════════════════════"
  echo ""
fi

# ──── 1. Phantom worktrees (paths missing) ───────────────────────────────────
if [ "$MODE" != "json" ]; then bold "[1/10] Phantom worktrees (paths missing)..."; fi
PHANTOM=0
while IFS= read -r wtpath; do
  [ -d "$wtpath" ] && continue
  if [ "$DRY" = "true" ]; then
    record_finding "phantom-wt:$wtpath"
    [ "$MODE" != "json" ] && yellow "  DRY-RUN: would prune $wtpath"
  else
    git worktree prune 2>&1 | head -1
    record_action "pruned-phantom:$wtpath"
    [ "$MODE" != "json" ] && green "  pruned: $wtpath"
  fi
  PHANTOM=$((PHANTOM+1))
done < <(git worktree list --porcelain 2>/dev/null | grep '^worktree ' | awk '{print $2}')

[ "$MODE" != "json" ] && [ "$PHANTOM" -eq 0 ] && echo "  (none)"
echo ""

# ──── 2. Stale stashes (auto-drop with threshold) ────────────────────────────
if [ "$MODE" != "json" ]; then bold "[2/10] Stale stashes..."; fi
THRESHOLD=$STALE_DAYS_SAFE
[ "$MODE" = "deep" ] && THRESHOLD=$STALE_DAYS_DEEP
NOW_EPOCH=$(date +%s)
DAY_SEC=86400
STALE_STASH=0
while IFS= read -r line; do
  name="${line%%:*}"
  rest="${line#*:}"
  ts_epoch="${rest%% *}"
  age_days=$(( (NOW_EPOCH - ts_epoch) / DAY_SEC ))
  if [ "$age_days" -gt "$THRESHOLD" ]; then
    if [ "$DRY" = "true" ]; then
      record_finding "stale-stash:$name (age ${age_days}d > ${THRESHOLD}d)"
      [ "$MODE" != "json" ] && yellow "  DRY-RUN: would drop $name (age ${age_days}d)"
    else
      git stash drop "$name" --quiet 2>&1 | head -1
      record_action "dropped-stash:$name"
      [ "$MODE" != "json" ] && green "  dropped $name (age ${age_days}d)"
    fi
    STALE_STASH=$((STALE_STASH+1))
  else
    [ "$MODE" != "json" ] && yellow "  WARN: recent stash $name (age ${age_days}d) — keep"
  fi
done < <(git stash list --format="%gd:%ct" 2>/dev/null)
[ "$MODE" != "json" ] && [ "$STALE_STASH" -eq 0 ] && echo "  (none above ${THRESHOLD}d)"
echo ""

# ──── 3. Working tree dirty: regenerable files → auto-discard ────────────────
if [ "$MODE" != "json" ]; then bold "[3/10] Dirty tree — regenerable files (auto-discard)..."; fi
DISCARDED=0
while IFS= read -r line; do
  [ -z "$line" ] && continue
  status="${line:0:2}"
  fpath="${line:3}"
  # Auto-discard candidates: gitignored paths
  case "$fpath" in
    */runtimes/*|*/.ovav/integrity/*|*/.ovav/worktrees/.worktrees/*)
      if [ "$DRY" = "true" ]; then
        record_finding "regenerable-dirty:$fpath"
        [ "$MODE" != "json" ] && yellow "  DRY-RUN: would discard $fpath"
      else
        git checkout -- "$fpath" 2>/dev/null || rm -rf "$fpath"
        record_action "discarded-dirty:$fpath"
        [ "$MODE" != "json" ] && green "  discarded: $fpath"
      fi
      DISCARDED=$((DISCARDED+1))
      ;;
    clients/opencode/skills/*)
      [ "$MODE" != "json" ] && yellow "  WARN: projection dirty $fpath (gitignored — sync will regenerate)"
      ;;
  esac
done < <(git status --short 2>/dev/null | grep -E "^\s*M\s" || true)
[ "$MODE" != "json" ] && [ "$DISCARDED" -eq 0 ] && echo "  (no regenerable dirty files)"
echo ""

# ──── 4. Untracked files: regenerable → discard ──────────────────────────────
if [ "$MODE" != "json" ]; then bold "[4/10] Untracked — regenerable files..."; fi
UNTRACKED_CLEANED=0
while IFS= read -r fpath; do
  case "$fpath" in
    */runtimes/*|*/.ovav/integrity/*|*.log.old|*.bak|*.swp|*.swo)
      if [ "$DRY" = "true" ]; then
        record_finding "regenerable-untracked:$fpath"
        [ "$MODE" != "json" ] && yellow "  DRY-RUN: would rm -rf $fpath"
      else
        rm -rf "$OVAV_ROOT/$fpath"
        record_action "removed-untracked:$fpath"
        [ "$MODE" != "json" ] && green "  removed: $fpath"
      fi
      UNTRACKED_CLEANED=$((UNTRACKED_CLEANED+1))
      ;;
    runtimes/opencode/agents/*)
      [ "$MODE" != "json" ] && yellow "  INFO: untracked agent $fpath — gitignore if persistent"
      ;;
  esac
done < <(git status --short 2>/dev/null | grep '^??' | awk '{print $2}' || true)
[ "$MODE" != "json" ] && [ "$UNTRACKED_CLEANED" -eq 0 ] && echo "  (no regenerable untracked)"
echo ""

# ──── 5. Conflict markers in tracked files ───────────────────────────────────
if [ "$MODE" != "json" ]; then bold "[5/10] Conflict markers in tracked files..."; fi
CONFLICT_FILES=()
while IFS= read -r line; do
  [ -z "$line" ] && continue
  case "$line" in
    UU|AA|DD|AU|UA|DU|UD)
      fpath=$(git status --short 2>/dev/null | grep "^$line" | head -1 | awk '{print $2}')
      CONFLICT_FILES+=("$fpath")
      ;;
  esac
done < <(git ls-files -u 2>/dev/null | awk '{print $1}' | sort -u || true)

# Faster: search recursively for conflict markers
CONFLICT_MARKERS=$(grep -rE '^(<<<<<<<|=======$|>>>>>>>)' \
  --exclude-dir=.git --exclude-dir=runtimes --exclude-dir=node_modules \
  --exclude-dir=clients --exclude-dir=.cache --exclude-dir=backups \
  --exclude-dir=dist \
  . 2>/dev/null || true)
if [ -n "$CONFLICT_MARKERS" ]; then
  CONFLICT_FILE_COUNT=$(echo "$CONFLICT_MARKERS" | cut -d: -f1 | sort -u | wc -l)
  record_finding "conflict-markers:$CONFLICT_FILE_COUNT files"
  [ "$MODE" != "json" ] && yellow "  WARN: $CONFLICT_FILE_COUNT files contain conflict markers"
  echo "$CONFLICT_MARKERS" | head -5 | sed 's/^/    /'
else
  [ "$MODE" != "json" ] && green "  (no conflict markers found)"
fi
echo ""

# ──── 6. Git lock files (stale) ──────────────────────────────────────────────
if [ "$MODE" != "json" ]; then bold "[6/10] Git lock files (stale)..."; fi
LOCK_FILES=$(find .git -maxdepth 2 -name "*.lock" 2>/dev/null || true)
STALE_LOCKS=0
for lock in $LOCK_FILES; do
  if [ -f "$lock" ]; then
    age=$(($(date +%s) - $(stat -c %Y "$lock")))
    if [ "$age" -gt 300 ]; then  # older than 5 minutes
      if [ "$DRY" = "true" ]; then
        record_finding "stale-lock:$lock (age ${age}s)"
        [ "$MODE" != "json" ] && yellow "  DRY-RUN: would rm $lock"
      else
        rm -f "$lock"
        record_action "removed-stale-lock:$lock"
        [ "$MODE" != "json" ] && green "  removed stale: $lock"
      fi
      STALE_LOCKS=$((STALE_LOCKS+1))
    fi
  fi
done
[ "$MODE" != "json" ] && [ "$STALE_LOCKS" -eq 0 ] && echo "  (no stale locks)"
echo ""

# ──── 7. Git GC + repack ─────────────────────────────────────────────────────
if [ "$MODE" != "json" ]; then bold "[7/10] Git GC + repack..."; fi
if [ "$DRY" = "true" ]; then
  [ "$MODE" != "json" ] && yellow "  DRY-RUN: would run 'git gc --auto --prune=now'"
else
  git gc --auto --prune=now 2>&1 | head -2
  record_action "git-gc"
  [ "$MODE" != "json" ] && green "  git gc complete"
fi
echo ""

# ──── 8. Consumer audit log rotation (>30 days) ─────────────────────────────
if [ "$MODE" != "json" ]; then bold "[8/10] Consumer audit log rotation..."; fi
AUDIT_LOG="$OVAV_ROOT/.ovav/runtime/logs/consumer_audit.jsonl"
if [ -f "$AUDIT_LOG" ]; then
  age=$(( ($(date +%s) - $(stat -c %Y "$AUDIT_LOG")) / DAY_SEC ))
  size_mb=$(du -m "$AUDIT_LOG" 2>/dev/null | awk '{print $1}')
  if [ "$age" -gt "$STALE_DAYS_SAFE" ] || [ "${size_mb:-0}" -gt 10 ]; then
    if [ "$DRY" = "true" ]; then
      record_finding "audit-log-rotate (age ${age}d, ${size_mb}MB)"
      [ "$MODE" != "json" ] && yellow "  DRY-RUN: would rotate (gzip + archive)"
    else
      ARCHIVE_DIR="$OVAV_ROOT/.ovav/runtime/logs/.archive"
      mkdir -p "$ARCHIVE_DIR"
      archived="$ARCHIVE_DIR/consumer_audit-$(date +%Y%m%d).jsonl.gz"
      gzip -c "$AUDIT_LOG" > "$archived" && : > "$AUDIT_LOG"
      record_action "rotated-audit-log:→$archived"
      [ "$MODE" != "json" ] && green "  archived: $archived"
    fi
  else
    [ "$MODE" != "json" ] && green "  fresh (age ${age}d, ${size_mb}MB) — keep"
  fi
else
  [ "$MODE" != "json" ] && echo "  (no audit log)"
fi
echo ""

# ──── 9. Stale branches ───────────────────────────────────────────────────────
if [ "$MODE" != "json" ]; then bold "[9/10] Stale branches (no remote, merged)..."; fi
STALE_BRANCHES=()
while IFS= read -r branch; do
  [ "$branch" = "develop" ] || [ "$branch" = "main" ] || [ "$branch" = "master" ] && continue
  # Has remote tracking?
  if ! git rev-parse --verify --quiet "origin/$branch" >/dev/null 2>&1; then
    STALE_BRANCHES+=("$branch (no remote)")
    continue
  fi
  # Already merged to develop?
  if git branch --merged develop 2>/dev/null | grep -qE "^\s*\*?\s*$branch$"; then
    STALE_BRANCHES+=("$branch (merged)")
  fi
done < <(git branch --format='%(refname:short)' 2>/dev/null)

if [ ${#STALE_BRANCHES[@]} -eq 0 ]; then
  [ "$MODE" != "json" ] && green "  (no stale branches)"
else
  for b in "${STALE_BRANCHES[@]}"; do
    record_finding "stale-branch:$b"
    [ "$MODE" != "json" ] && yellow "  $b — review and git branch -d"
  done
fi
echo ""

# ──── 10. Final summary ───────────────────────────────────────────────────────
if [ "$MODE" = "json" ]; then
  printf '{"mode":"%s","dry_run":%s,"actions_count":%d,"findings_count":%d,"actions":[%s],"findings":[%s]}\n' \
    "$MODE" \
    "$([ "$DRY" = "true" ] && echo true || echo false)" \
    "${#ACTIONS[@]}" \
    "${#FINDINGS[@]}" \
    "$(printf '"%s",' "${ACTIONS[@]}" | sed 's/,$//')" \
    "$(printf '"%s",' "${FINDINGS[@]}" | sed 's/,$//')"
  exit 0
fi

bold "═══════════════════════════════════════════════════════════"
bold " owtidy summary"
bold "═══════════════════════════════════════════════════════════"
echo ""
echo "  Actions:    ${#ACTIONS[@]}"
echo "  Findings:   ${#FINDINGS[@]}"
echo "  Mode:       $MODE (dry_run=$DRY)"
echo ""
if [ ${#ACTIONS[@]} -gt 0 ]; then
  green "  Actions taken:"
  for a in "${ACTIONS[@]}"; do
    echo "    - $a" | head -1
  done
fi
if [ ${#FINDINGS[@]} -gt 0 ]; then
  yellow "  Findings (require human review):"
  for f in "${FINDINGS[@]}"; do
    echo "    - $f" | head -1
  done
fi
echo ""
bold "  Tips:"
echo "    - Run 'owp' to push local commits after this cleanup."
echo "    - Run 'git status' to see the post-cleanup state."
echo "    - Run 'owtidy --deep' for more aggressive cleanup (>7d stashes)."
echo ""

# Audit entry
mkdir -p "$OVAV_ROOT/.ovav/runtime/logs"
printf '{"ts":"%s","actor":"%s","command":"owtidy","mode":"%s","actions":%d,"findings":%d}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${USER:-unknown}" "$MODE" "${#ACTIONS[@]}" "${#FINDINGS[@]}" \
  >> "$OVAV_ROOT/.ovav/runtime/logs/consumer_audit.jsonl"
