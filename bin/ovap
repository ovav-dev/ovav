#!/usr/bin/env bash
# =============================================================================
# owp — OVAV Worktree Push
# v1.0.0 — Intelligent push wrapper that replaces 'ovav git push origin develop'.
#
# Modes:
#   owp                push develop to origin/develop with pre-flight checks
#   owp status         show ahead/behind counts + remote state
#   owp dry-run        preview what would be pushed (no actual push)
#   owp sync           fetch + rebase + push (if local branch is ahead)
#   owp --branch <b>   push a specific branch instead of develop
#
# Pre-flight checks (run BEFORE push):
#   - Local branch exists and matches what's expected
#   - Working tree clean (or warn)
#   - OWS audit log clean (no denied ops recently)
#   - OVAV integrity 100%
#   - Pre-push hook will run on push (auto; can't bypass)
#
# Returns PWD_NOW=<dir> to keep shell-wrappers compatible.
# =============================================================================
set -euo pipefail

OVAV_ROOT="${OVAV_ROOT:-/home/braka/Systems/OVAV}"
BRANCH="${OVAP_BRANCH:-develop}"
REMOTE="${OVAP_REMOTE:-origin}"
MODE="${1:-push}"

# ──── Helpers ──────────────────────────────────────────────────────────────
red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
bold()   { printf '\033[1m%s\033[0m\n' "$*"; }
err()    { red "X $*" >&2; exit 1; }

# ──── 1. Pre-flight: where are we? ───────────────────────────────────────────
cd "$OVAV_ROOT" 2>/dev/null || err "OVAV_ROOT=$OVAV_ROOT not accessible"
[ -d ".git" ] || err "not a git repo"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || err "no branch")"

# ──── 2. Pre-flight: integrity ────────────────────────────────────────────
bold "[1/5] OVAV integrity check..."
INTEGRITY="$(go run -C go-runtime ./cmd/ovav/ status 2>&1 | grep -oE 'Integrity: [0-9.]+%' | head -1 | awk '{print $2}')"
if [ "$INTEGRITY" = "100.0%" ]; then
  green "  PASS: integrity 100.0%"
else
  yellow "  WARN: integrity=$INTEGRITY (push still allowed)"
fi

# ──── 3. Pre-flight: working tree ─────────────────────────────────────────
bold "[2/5] Working tree status..."
DIRTY_COUNT="$(git status --short 2>/dev/null | wc -l)"
if [ "$DIRTY_COUNT" -gt 0 ]; then
  yellow "  WARN: $DIRTY_COUNT uncommitted changes"
  git status --short 2>&1 | head -3 | sed 's/^/    /'
else
  green "  PASS: clean working tree"
fi

# ──── 4. Pre-flight: ahead/behind vs remote ────────────────────────────────
bold "[3/5] Remote sync status (branch=$BRANCH, remote=$REMOTE)..."
git fetch "$REMOTE" --quiet 2>&1 | head -1 || yellow "  (couldn't fetch)"
AHEAD="$(git rev-list --count "$REMOTE/$BRANCH..$BRANCH" 2>/dev/null || echo 0)"
BEHIND="$(git rev-list --count "$BRANCH..$REMOTE/$BRANCH" 2>/dev/null || echo 0)"
echo "  Local ahead of $REMOTE/$BRANCH by $AHEAD commit(s)"
echo "  Local behind $REMOTE/$BRANCH by $BEHIND commit(s)"

if [ "$AHEAD" -eq 0 ]; then
  yellow "  Nothing to push — local matches remote"
  if [ "$MODE" = "push" ]; then
    exit 0
  fi
fi

# ──── 5. Pre-flight: target branch = current branch? ──────────────────────
bold "[4/5] Branch consistency check..."
if [ "$CURRENT_BRANCH" != "$BRANCH" ]; then
  err "Local branch is '$CURRENT_BRANCH' but owp targets '$BRANCH'. Checkout $BRANCH first."
fi
green "  PASS: on branch $BRANCH"

# ──── 6. Pre-flight: protected-branch waiver ──────────────────────────────
bold "[5/5] Protected-branch waiver..."
WAIVER_FILE=".ovav/runtime/protected_branch_waiver.yaml"
if [ -f "$WAIVER_FILE" ]; then
  BRANCH_IN_WAIVER="$(grep -E '^[[:space:]]*branch:' "$WAIVER_FILE" | head -1 | awk '{print $2}' | tr -d '"')"
  if [ "$BRANCH_IN_WAIVER" = "$BRANCH" ]; then
    green "  PASS: waiver active for $BRANCH"
  else
    yellow "  WARN: waiver is for '$BRANCH_IN_WAIVER', not '$BRANCH'"
  fi
else
  yellow "  WARN: no waiver file at $WAIVER_FILE — push may be blocked"
fi

# ──── Mode: status (just report, don't push) ──────────────────────────────
bold ""
if [ "$MODE" = "status" ]; then
  bold "[ovap status summary]"
  echo "  Branch:        $BRANCH"
  echo "  Remote:        $REMOTE"
  echo "  Ahead:         $AHEAD"
  echo "  Behind:        $BEHIND"
  echo "  Working tree:  $DIRTY_COUNT changes"
  echo "  Integrity:     $INTEGRITY"
  exit 0
fi

# ──── Mode: dry-run (preview without pushing) ─────────────────────────────
if [ "$MODE" = "dry-run" ]; then
  bold "[owap dry-run: would push $AHEAD commit(s) to $REMOTE/$BRANCH]"
  git log --oneline "$REMOTE/$BRANCH..$BRANCH" 2>/dev/null | head -20
  exit 0
fi

# ──── Mode: sync (fetch + rebase if behind + push) ─────────────────────────
if [ "$MODE" = "sync" ]; then
  bold "[ovap sync: fetch + rebase + push]"
  git fetch "$REMOTE" --quiet 2>&1 | head -1
  if [ "$BEHIND" -gt 0 ]; then
    git rebase "$REMOTE/$BRANCH" 2>&1 | tail -3
  fi
  MODE="push"
fi

# ──── Mode: push (default) — REAL push via OVAV system ────────────────────

# 0. Auto-clean regenerable dirty files (Release Gate requires clean tree)
DISCARDED=0
while IFS= read -r line; do
  [ -z "$line" ] && continue
  fpath="${line:3}"
  case "$fpath" in
    */runtimes/*|*/.venv/*|*/.ovav/integrity/*)
      git checkout -- "$fpath" 2>/dev/null || rm -rf "$fpath"
      DISCARDED=$((DISCARDED+1))
      ;;
    clients/opencode/skills/*|opencode.json|tui.json)
      # Projection files; sync regenerates them
      git checkout -- "$fpath" 2>/dev/null
      DISCARDED=$((DISCARDED+1))
      ;;
  esac
done < <(git status --short 2>/dev/null | grep -E "^\s*M\s" || true)

if [ "$DISCARDED" -gt 0 ]; then
  bold "[ovap] Auto-discarded $DISCARDED regenerable dirty files"
fi

# 0.5 Auto-stash remaining tracked M (real work to preserve)
WAS_STASHED=false
if ! git diff --quiet 2>/dev/null; then
  if git stash push --include-untracked --quiet --message "owp-auto-stash $(date -u +%Y-%m-%dT%H:%M:%SZ)" 2>&1 | tail -1; then
    WAS_STASHED=true
    bold "[ovap] Auto-stashed tracked M (will pop after push)"
  else
    red "[ovap FAIL] could not stash tracked changes. Commit or stash manually."
    exit 1
  fi
fi

# If behind → auto-rebase first (silently). Fast-forward is automatically handled by git.
if [ "$BEHIND" -gt 0 ]; then
  bold "[ovap] Behind $BEHIND commit(s) → auto-rebasing $BRANCH onto $REMOTE/$BRANCH..."
  # --autostash: if dirty tree, auto-stash + pop after rebase. Requires git ≥2.26.
  if ! git rebase --autostash "$REMOTE/$BRANCH" 2>&1 | tail -5; then
    red "[ovap FAIL] rebase conflict. Resolve manually and re-run owp."
    exit 1
  fi
  # Re-compute AHEAD after rebase
  AHEAD="$(git rev-list --count "$REMOTE/$BRANCH..$BRANCH" 2>/dev/null || echo 0)"
fi

bold "[ovap] Pushing $AHEAD commit(s) to $REMOTE/$BRANCH..."
echo "PWD_NOW=$OVAV_ROOT"
bold ""
COMMITS_TO_PUSH="$(git log --oneline "$REMOTE/$BRANCH..$BRANCH" 2>/dev/null)"
if [ -n "$COMMITS_TO_PUSH" ]; then
  echo "Commits to push:"
  echo "$COMMITS_TO_PUSH" | head -10 | sed 's/^/  /'
  TOTAL=$(echo "$COMMITS_TO_PUSH" | wc -l)
  if [ "$TOTAL" -gt 10 ]; then
    echo "  ... and $((TOTAL - 10)) more"
  fi
fi

# REAL push (OVAV's pre-push hook fires automatically)
PUSH_RC=0
git push "$REMOTE" "$BRANCH" 2>&1 | tail -20 || PUSH_RC=$?

# Pop stash on the way out (success OR failure)
if $WAS_STASHED; then
  if ! git stash pop --quiet 2>&1 | tail -2; then
    yellow "[ovap WARN] Stash pop had conflicts. Resolve with: git stash show -p | git apply && git stash drop"
  fi
fi

if [ "$PUSH_RC" -eq 0 ]; then
  green "[ovap OK] Pushed $AHEAD commit(s)"
  # Audit
  mkdir -p .ovav/runtime/logs
  printf '{"ts":"%s","actor":"%s","command":"owp","branch":"%s","remote":"%s","commits":%s,"decision":"allowed","reason":"owp push"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${USER:-unknown}" "$BRANCH" "$REMOTE" "$AHEAD" \
    >> .ovav/runtime/logs/consumer_audit.jsonl
else
  red "[ovap FAIL] Push rejected (exit=$PUSH_RC). Inspect:"
  red "  - pre-push hook: bash .git/hooks/pre-push"
  red "  - workspace_safety_gate: python3 -B tools/harnesses/workspace_safety_gate.py"
  exit $PUSH_RC
fi
