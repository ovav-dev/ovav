#!/usr/bin/env bash
# OVAV Consumer Bridge - Official CLI
# v1.1.0 - Adds verify, uninstall, multi-language OWS, tiered commands
#
# SAFETY: This script never mutates permission_authority.json directly.
# It only writes to .ovav/registry/consumers.yaml and the audit log.
# Granting actual permissions requires CEO approval via `ovav-consumer grant`.

set -euo pipefail

OVAV_ROOT="${OVAV_ROOT:-/home/braka/Systems/OVAV}"
CONSUMERS_REGISTRY="$OVAV_ROOT/.ovav/registry/consumers.yaml"
AUDIT_LOG="$OVAV_ROOT/.ovav/runtime/logs/consumer_audit.jsonl"
PYTHON_HELPER="/tmp/opencode/ovav_consumer_helper.py"

red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
bold()   { printf '\033[1m%s\033[0m\n' "$*"; }
die()   { red "X $1" >&2; exit 1; }
ok()    { green "OK $1"; }
warn()  { yellow "! $1"; }

# ──── Logging ──────────────────────────────────────────────────────────────
log_audit() {
  local decision="$1"; local reason="$2"; local ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$(dirname "$AUDIT_LOG")"
  printf '{"ts":"%s","actor":"%s","command":"%s","consumer_id":"%s","decision":"%s","reason":"%s"}\n' \
    "$ts" "${USER:-unknown}" "${OVAV_CMD:-unknown}" "${OVAV_TARGET:-none}" "$decision" "$reason" \
    >> "$AUDIT_LOG"
}

# ──── Validators ───────────────────────────────────────────────────────────
validate_consumer_id() {
  local id="$1"
  echo "$id" | grep -qE '^[a-z][a-z0-9-]{2,30}$' || die "Invalid consumer_id. Must be lowercase kebab-case, 3-31 chars."
  case "$id" in *..*|*"/"*|*'\\'*) die "consumer_id contains path-traversal chars";; esac
}

validate_waiver() {
  local waiver="$1"
  [ ! -f "$waiver" ] && die "Waiver file not found: $waiver"
  [ ! -r "$waiver" ] && die "Waiver file not readable: $waiver"
  for field in consumer_id: approved_by: approved_at: scope:; do
    grep -qF "$field" "$waiver" || die "Waiver missing required field: $field"
  done
  grep -qE "approved_by:[[:space:]]+(Alexander Salvador|Braka|CEO de OVAV)" "$waiver" \
    || die "Waiver approver must be 'Alexander Salvador' (CEO de OVAV)"
}

# ──── Commands ─────────────────────────────────────────────────────────────
cmd_register() {
  local consumer_id="" root="" waiver=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --root)    root="$2"; shift 2 ;;
      --waiver)  waiver="$2"; shift 2 ;;
      --*)       die "Unknown flag: $1" ;;
      *)         consumer_id="$1"; shift ;;
    esac
  done
  [ -z "$consumer_id" ] && die "Usage: ovav-consumer register <id> --root <path> --waiver <file>"
  [ -z "$root" ]        && die "--root required"
  [ -z "$waiver" ]      && die "--waiver required"

  OVAV_CMD="register"
  OVAV_TARGET="$consumer_id"
  bold "=== OVAV Consumer Registration ==="
  echo ""
  validate_consumer_id "$consumer_id"
  validate_waiver "$waiver"
  [ ! -d "$root" ] && die "Consumer root does not exist: $root"
  if [ ! -d "$root/.git" ] && [ ! -d "$root/.ovav" ]; then
    die "Consumer root is not a git repo and has no .ovav config: $root"
  fi
  if [ -f "$CONSUMERS_REGISTRY" ] && grep -qE "id: $consumer_id(\\s|$)" "$CONSUMERS_REGISTRY"; then
    die "Consumer '$consumer_id' already registered."
  fi

  mkdir -p "$(dirname "$CONSUMERS_REGISTRY")"
  if [ ! -f "$CONSUMERS_REGISTRY" ]; then
    cat > "$CONSUMERS_REGISTRY" <<'YAML'
# OVAV Consumer Registry - v1
schema: ovav.consumer_registry.v1
initialized_at: CHANGE_ME
governor: Thavren - Lead, Platform Engineering
purpose: >
  Registry of external consumer projects authorized to access OVAV subsystems.
consumers: []
last_updated: CHANGE_ME
YAML
  fi

  local subs caps contact ts
  subs=$(grep -A 10 "subsystems:" "$waiver" 2>/dev/null | grep "^  *-" | sed 's/.*- //' | tr '\n' ',' | sed 's/,$//' || true)
  subs=${subs:-"ows"}
  caps=$(grep -A 20 "capabilities:" "$waiver" 2>/dev/null | grep "^  *-" | head -10 | sed 's/.*- //' | tr '\n' ',' | sed 's/,$//' || true)
  contact=$(grep "approved_by:" "$waiver" 2>/dev/null | head -1 | sed 's/approved_by:[[:space:]]*//' || echo "unknown")
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  python3 "$PYTHON_HELPER" yaml_append \
    "$CONSUMERS_REGISTRY" "$consumer_id" "$root" "$waiver" "$subs" "$caps" "$contact" "$ts" >/dev/null
  ok "Consumer '$consumer_id' registered (state: registered)"
}

cmd_grant() {
  local consumer_id="${1:-}"
  [ -z "$consumer_id" ] && die "Usage: ovav-consumer grant <id>"
  [ -z "${CEO_APPROVED:-}" ] && die "Grant requires CEO_APPROVED=1"
  OVAV_CMD="grant"; OVAV_TARGET="$consumer_id"
  bold "=== OVAV Consumer Grant - CEO-Only ==="
  [ ! -f "$CONSUMERS_REGISTRY" ] && die "Registry not found"
  local ts; ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  python3 "$PYTHON_HELPER" grant_patch "$CONSUMERS_REGISTRY" "$consumer_id" "$ts"
}

cmd_list() {
  OVAV_CMD="list"
  python3 "$PYTHON_HELPER" yaml_list "$CONSUMERS_REGISTRY"
}

cmd_audit() {
  local consumer_id="${1:-}"
  OVAV_CMD="audit"; OVAV_TARGET="$consumer_id"
  [ -z "$consumer_id" ] && die "Usage: ovav-consumer audit <id>"
  python3 "$PYTHON_HELPER" audit_filter "$AUDIT_LOG" "$consumer_id"
}

cmd_revoke() {
  local consumer_id="${1:-}"
  OVAV_CMD="revoke"; OVAV_TARGET="$consumer_id"
  [ -z "$consumer_id" ] && die "Usage: ovav-consumer revoke <id>"
  if [ -z "${CEO_APPROVED:-}" ] && [ -z "${ALLOW_REVOKE:-}" ]; then
    die "Revoke requires CEO_APPROVED=1 or ALLOW_REVOKE=1"
  fi
  [ ! -f "$CONSUMERS_REGISTRY" ] && die "Registry not found"
  local ts; ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  python3 "$PYTHON_HELPER" yaml_mark_revoked "$CONSUMERS_REGISTRY" "$consumer_id" "$ts"
  ok "Consumer '$consumer_id' marked as revoked"
}

cmd_install() {
  local consumer_id="" root="" waiver="" skip_register="false"
  while [ $# -gt 0 ]; do
    case "$1" in
      --root)        root="$2"; shift 2 ;;
      --waiver)      waiver="$2"; shift 2 ;;
      --skip-register) skip_register="true"; shift ;;
      --*)           die "Unknown flag: $1" ;;
      *)             consumer_id="$1"; shift ;;
    esac
  done
  [ -z "$consumer_id" ] && die "Usage: ovav-consumer install <id> --root <path> --waiver <file>"
  [ -z "$root" ]        && die "--root required"
  [ ! -d "$root" ]      && die "Consumer root does not exist: $root"

  OVAV_CMD="install"; OVAV_TARGET="$consumer_id"

  bold "=== OVAV Consumer Install (one-shot) ==="
  echo ""
  echo "  Consumer ID:   $consumer_id"
  echo "  Consumer root: $root"
  echo ""

  # Auto-register if waiver provided
  if [ "$skip_register" != "true" ]; then
    [ -z "$waiver" ] && die "--waiver required for first-time install"
    if grep -qE "id: $consumer_id(\\s|$)" "$CONSUMERS_REGISTRY" 2>/dev/null; then
      ok "  [1/6] Consumer already registered"
    else
      yellow "  [1/6] Registering consumer..."
      cmd_register "$consumer_id" --root "$root" --waiver "$waiver"
    fi
  fi

  # STEP 2: Grant check
  yellow "  [2/6] Checking grant..."
  if [ -n "${CEO_APPROVED:-}" ]; then
    ok "  [2/6] CEO_APPROVED present - granted"
  else
    warn "  [2/6] CEO_APPROVED not set - grant not applied in this session"
    warn "         Re-run with CEO_APPROVED=1 to apply grant"
  fi

  # STEP 3: Project sync (OVAV source -> consumer runtime)
  yellow "  [3/6] Syncing OVAV agents + skills (320+ components)..."
  if (cd "$OVAV_ROOT" && go run -C go-runtime ./cmd/ovav/ project sync --agents --skills 2>&1 | tail -3); then
    ok "  [3/6] Project sync complete"
  else
    warn "  [3/6] Project sync had warnings (continuing)"
  fi

  # STEP 4: OWS Worktree subsystem - global install via symlinks
  yellow "  [4/6] Installing global OWS shims (~/.local/bin/)..."
  mkdir -p "$HOME/.local/bin"
  OWS_CMDS="owc owd owl owv ows owclean owm owx owa owr owlk"
  INSTALLED=0
  for c in $OWS_CMDS; do
    target="$OVAV_ROOT/bin/ovav-$c"
    if [ ! -f "$target" ]; then
      printf '#!/usr/bin/env bash\nexec "%s/ovav-ow-runtime.sh" "$@"\n' "$OVAV_ROOT" > "$target"
      chmod +x "$target"
    fi
    ln -sf "$target" "$HOME/.local/bin/ovav-$c" 2>/dev/null && INSTALLED=$((INSTALLED+1))
    ln -sf "$target" "$HOME/.local/bin/ow$c" 2>/dev/null || true
  done
  ok "  [4/6] $INSTALLED OWS shims linked globally (+ unprefixed aliases)"

  # STEP 5: Project-link + audit
  yellow "  [5/6] Project-link + audit..."
  mkdir -p "$root/.ovav"
  cat > "$root/.ovav/consumer-link.json" <<LINKEOF
{
  "consumer_id": "$consumer_id",
  "ovav_root": "$OVAV_ROOT",
  "linked_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "global_aliases": true,
  "shims_count": $INSTALLED
}
LINKEOF
  log_audit "allowed" "install: $INSTALLED OWS shims, project synced"
  ok "  [5/6] Audit + project-link written"

  # STEP 6: Auto-bootstrap project-local shims
  yellow "  [6/6] Auto-bootstrap project-local shims in $root ..."
  if [ -f "$OVAV_ROOT/clients/ovav-consumer-bootstrap.sh" ]; then
    if bash "$OVAV_ROOT/clients/ovav-consumer-bootstrap.sh" 2>&1 | tail -3; then
      ok "  [6/6] Project-local shims installed"
    else
      warn "  [6/6] Bootstrap returned warnings (continuing)"
    fi
  else
    warn "  [6/6] Bootstrap script not found, skipping"
  fi

  bold ""
  bold "=== Install Complete ==="
  echo ""
  echo "  $consumer_id is now wired:"
  echo "    - OVAV agents/skills synced to $OVAV_ROOT/clients/opencode/"
  echo "    - OWS commands global via ~/.local/bin/ow{c,d,l,v,s,clean,m,x,a,r,lk}"
  echo "    - Project-link: $root/.ovav/consumer-link.json"
  echo "    - Project-local shims: $root/bin/"
  echo "    - Audit trail: $AUDIT_LOG"
}

cmd_verify() {
  local consumer_id="${1:-}"
  [ -z "$consumer_id" ] && die "Usage: ovav-consumer verify <id>"
  OVAV_CMD="verify"; OVAV_TARGET="$consumer_id"

  bold "=== OVAV Consumer Verify: $consumer_id ==="
  echo ""
  PASS=0; FAIL=0
  okcheck()  { green "  OK $*"; PASS=$((PASS+1)); }
  failcheck(){ red   "  ERR $*"; FAIL=$((FAIL+1)); }
  warncheck() { yellow "  WARN $*"; }

  if grep -qE "id: $consumer_id(\s|$)" "$CONSUMERS_REGISTRY" 2>/dev/null; then
    okcheck "Registry entry present"
  else
    failcheck "Registry entry MISSING ($CONSUMERS_REGISTRY)"
  fi

  SHIMS=0
  for cmd in c d l v s clean m x a r lk; do
    [ -f "$HOME/.local/bin/ovav-ow$cmd" ] && SHIMS=$((SHIMS+1))
  done
  if [ "$SHIMS" -eq 11 ]; then
    okcheck "Global OWS shims: 11/11"
  else
    failcheck "Global OWS shims: $SHIMS/11"
  fi

  if [ -d "$OVAV_ROOT/clients/opencode/skills" ]; then
    cnt=$(ls "$OVAV_ROOT/clients/opencode/skills/" 2>/dev/null | wc -l)
    okcheck "Skills synced ($cnt skills in clients/opencode/skills/)"
  else
    failcheck "Skills directory missing"
  fi

  if [ -w "$(dirname "$AUDIT_LOG")" ] 2>/dev/null; then
    okcheck "Audit log directory writable"
  else
    failcheck "Audit log NOT writable"
  fi

  if (cd "$OVAV_ROOT" && go run -C go-runtime ./cmd/ovav/ status 2>&1 | grep -q "Integrity: 100.0%"); then
    okcheck "OVAV integrity 100%"
  else
    failcheck "OVAV integrity NOT 100%"
  fi

  if [ -f "$CONSUMERS_REGISTRY" ]; then
    root=$(grep -A 5 "id: $consumer_id$" "$CONSUMERS_REGISTRY" | grep "root_path:" | head -1 | sed 's/.*root_path:[[:space:]]*//' | tr -d '"' || true)
    if [ -n "$root" ] && [ -d "$root" ]; then
      okcheck "Consumer root exists: $root"
      if [ -f "$root/.ovav/consumer-link.json" ]; then
        okcheck "Project-link present"
      else
        warncheck "Project-link MISSING (run install to create)"
      fi
    else
      failcheck "Consumer root NOT found: $root"
    fi
  fi

  echo ""
  bold "  $PASS passed, $FAIL failed"
  [ "$FAIL" -eq 0 ] && ok "Consumer $consumer_id is healthy" || failcheck "Consumer $consumer_id has issues"
}

cmd_uninstall() {
  local consumer_id="${1:-}"
  OVAV_CMD="uninstall"; OVAV_TARGET="$consumer_id"
  [ -z "$consumer_id" ] && die "Usage: ovav-consumer uninstall <id> (requires CEO_APPROVED=1)"
  [ -z "${CEO_APPROVED:-}" ] && die "Uninstall requires CEO_APPROVED=1"

  bold "=== OVAV Consumer Uninstall: $consumer_id ==="
  echo ""

  if grep -qE "id: $consumer_id(\\s|$)" "$CONSUMERS_REGISTRY" 2>/dev/null; then
    local ts; ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    python3 "$PYTHON_HELPER" yaml_mark_revoked "$CONSUMERS_REGISTRY" "$consumer_id" "$ts"
    ok "Registry entry marked revoked"
  else
    warn "Registry entry not found (already uninstalled?)"
  fi

  for c in c d l v s clean m x a r lk; do
    rm -f "$HOME/.local/bin/ovav-ow$c" "$HOME/.local/bin/ow$c"
  done
  ok "Global OWS symlinks removed"

  log_audit "allowed" "uninstall: $consumer_id"
  ok "Audit entry logged"

  if [ -f "$CONSUMERS_REGISTRY" ]; then
    root=$(grep -A 5 "id: $consumer_id$" "$CONSUMERS_REGISTRY" | grep "root_path:" | head -1 | sed 's/.*root_path:[[:space:]]*//' | tr -d '"' || echo "")
    if [ -n "$root" ] && [ -f "$root/.ovav/consumer-link.json" ]; then
      rm -f "$root/.ovav/consumer-link.json"
      ok "Project-link removed"
    fi
  fi

  echo ""
  bold "  Uninstall complete. Re-run install to reset."
}

cmd_help() {
  bold "OVAV Consumer Bridge v1.1.0"
  echo "Official consumer registration CLI for OVAV"
  echo ""
  echo "Commands:"
  echo "  register <id> --root <path> --waiver <file>  Register a consumer"
  echo "  grant <id>                                    CEO: generate grant patch (CEO_APPROVED=1)"
  echo "  install <id> --root <path> --waiver <file>   One-shot: register + sync + global OWS"
  echo "  verify <id>                                   Health check of consumer setup"
  echo "  list                                          List all consumers"
  echo "  audit <id>                                    Show audit trail"
  echo "  revoke <id>                                   Revoke consumer (CEO_APPROVED=1)"
  echo "  uninstall <id>                                Full cleanup (CEO_APPROVED=1)"
  echo ""
  echo "ENV: OVAV_ROOT (default /home/braka/Systems/OVAV), CEO_APPROVED=1 for grant/revoke/uninstall"
  echo ""
  echo "See: .ovav/security/consumer_bridge.md"
}

# ──── Main ─────────────────────────────────────────────────────────────────
cmd="${1:-help}"
shift || true
OVAV_CMD="$cmd"

case "$cmd" in
  register)  cmd_register  "$@" ;;
  grant)     cmd_grant     "$@" ;;
  install)   cmd_install   "$@" ;;
  verify)    cmd_verify    "$@" ;;
  list)      cmd_list      ;;
  audit)     cmd_audit     "$@" ;;
  revoke)    cmd_revoke    "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  help|--help|-h) cmd_help ;;
  *) die "Unknown command: $cmd. Run 'ovav-consumer help'." ;;
esac
