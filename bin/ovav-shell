from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

def _is_dev() -> bool:
    """True if running in development/internal tier."""
    return os.environ.get("OVAV_DEV") == "1" or (ROOT / "tools" / "harnesses").exists()

LOGO = ROOT / "bin" / "ovav-logo"

ESC = chr(27)
C = {
    "reset": ESC + "[0m",
    "bold": ESC + "[1m",
    "dim": ESC + "[2m",
    "lav": ESC + "[38;2;180;190;254m",
    "mauve": ESC + "[38;2;203;166;247m",
    "pink": ESC + "[38;2;245;194;231m",
    "blue": ESC + "[38;2;137;180;250m",
    "cyan": ESC + "[38;2;148;226;213m",
    "green": ESC + "[38;2;166;227;161m",
    "yellow": ESC + "[38;2;249;226;175m",
    "red": ESC + "[38;2;243;139;168m",
    "sub": ESC + "[38;2;166;173;200m",
}

PAYLOAD_NAMES = (
    ".zip", ".tar", ".tar.gz", ".tgz", ".bak", ".backup",
    ".sqlite", ".db", ".pyc", ".log",
)
SKIP_DIRS = {".git", "node_modules", ".venv", "venv"}

def color_enabled() -> bool:
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

def s(value: str) -> str:
    if color_enabled():
        return value
    for code in C.values():
        value = value.replace(code, "")
    return value

def run(cmd: list[str], timeout: int = 8) -> tuple[int, str]:
    try:
        p = subprocess.run(cmd, cwd=ROOT, text=True, capture_output=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr).rstrip()
    except Exception as exc:
        return 99, str(exc)

def exists(path: str) -> bool:
    return (ROOT / path).exists()

def count_files(path: str, pattern: str = "*") -> int:
    base = ROOT / path
    if not base.exists():
        return 0
    return sum(1 for p in base.glob(pattern) if p.is_file() or p.is_dir())

def first_line(path: str, fallback: str = "") -> str:
    p = ROOT / path
    if not p.exists():
        return fallback
    lines = p.read_text(encoding="utf-8", errors="ignore").splitlines()
    return lines[0].strip() if lines else fallback

def git_branch() -> str:
    code, out = run(["git", "branch", "--show-current"])
    return out.strip() if code == 0 and out.strip() else "unknown"

def git_status_lines() -> list[str]:
    code, out = run(["git", "status", "--short"])
    return [line for line in out.splitlines() if line.strip()] if code == 0 else ["status-unavailable"]

def git_dirty() -> bool:
    return bool(git_status_lines())

def git_remote_present() -> bool:
    code, out = run(["git", "remote", "-v"])
    return code == 0 and bool(out.strip())

def has_pycache() -> bool:
    return any(ROOT.rglob("__pycache__")) or any(ROOT.rglob("*.pyc"))

def managed_surfaces() -> dict[str, bool]:
    return {
        "opencode_agents": exists(".opencode/agents"),
        "opencode_commands": exists(".opencode/commands"),
        "opencode_skills": exists(".opencode/skills"),
        "validators": exists("tools/validators"),
        "release_docs": exists("README.md") and exists("INSTALL.md") and exists("ROLLBACK.md"),
    }

def dependency_status() -> dict[str, bool]:
    return {
        "python3": shutil.which("python3") is not None,
        "git": shutil.which("git") is not None,
        "rg": shutil.which("rg") is not None,
        "opencode": shutil.which("opencode") is not None,
    }

def payload_hits(limit: int = 40) -> list[str]:
    hits: list[str] = []
    for base, dirs, files in os.walk(ROOT):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        rel_base = Path(base).relative_to(ROOT)
        if rel_base.parts and rel_base.parts[0] == ".git":
            continue
        if Path(base).name == "__pycache__":
            hits.append(str(Path(base).relative_to(ROOT)))
            if len(hits) >= limit:
                return hits
        for filename in files:
            path = Path(base) / filename
            if any(filename.endswith(suffix) for suffix in PAYLOAD_NAMES):
                hits.append(str(path.relative_to(ROOT)))
                if len(hits) >= limit:
                    return hits
    return hits

def validate_probe() -> dict[str, object]:
    validators = [
        ["python3", "-B", "tools/validators/validate_all.py"],
        ["python3", "-B", "tools/validators/check_build18_launch_pack.py"],
        ["python3", "-B", "tools/validators/check_final_launch_current_authority.py"],
        ["python3", "-B", "tools/validators/check_final_launch_runtime_authority.py"],
    ]
    results = []
    ok = True
    for cmd in validators:
        code, out = run(cmd, timeout=20)
        results.append({"cmd": " ".join(cmd), "ok": code == 0, "output": out.splitlines()[:3]})
        ok = ok and code == 0
    return {"ok": ok, "results": results}

def status_model() -> dict[str, object]:
    opencode_dir = ROOT / ".opencode"
    agents = count_files(".opencode/agents", "*.md")
    commands = count_files(".opencode/commands", "*.md")
    skills = count_files(".opencode/skills")
    validators = count_files("tools/validators", "*.py")
    dirty = git_dirty()
    pycache = has_pycache()
    surfaces = managed_surfaces()
    deps = dependency_status()
    secrets = []  # Removed — SEGURIDAD FASE A
    payload = payload_hits()
    opencode_ready = opencode_dir.exists() and agents > 0 and commands > 0 and skills > 0
    version = first_line("VERSION", "v1.0.0-rc6")

    state = "ready"
    if payload or pycache:
        state = "needs-cleanup"
    elif dirty:
        state = "work-in-progress"
    elif not opencode_ready:
        state = "needs-setup"

    return {
        "branch": git_branch(),
        "dirty": dirty,
        "changed_files": len(git_status_lines()),
        "mode": "source-local",
        "state": state,
        "version": version,
        "opencode": opencode_dir.exists(),
        "opencode_ready": opencode_ready,
        "agents": agents,
        "commands": commands,
        "skills": skills,
        "validators": validators,
        "pycache": pycache,
        "managed_surfaces": surfaces,
        "dependencies": deps,
        "security": {"secret_hits": len(secrets), "payload_hits": len(payload)},
        "remote": git_remote_present(),
    }

def readiness_score(model: dict[str, object]) -> tuple[int, int]:
    surfaces = model["managed_surfaces"]
    deps = model["dependencies"]
    checks = [
        bool(model["opencode_ready"]),
        int(model["agents"]) > 0,
        int(model["commands"]) > 0,
        int(model["skills"]) > 0,
        int(model["validators"]) > 0,
        all(bool(value) for value in surfaces.values()),
        bool(deps["python3"]),
        bool(deps["git"]),
        not bool(model["pycache"]),
        int(model["security"]["payload_hits"]) == 0,
    ]
    return sum(1 for item in checks if item), len(checks)

def mark(value: bool) -> str:
    return s(C["green"] + "ready" + C["reset"]) if value else s(C["yellow"] + "check" + C["reset"])

def state_label(model: dict[str, object]) -> str:
    state = str(model["state"])
    if state == "ready":
        return s(C["green"] + "ready" + C["reset"])
    if state == "security-attention":
        return s(C["red"] + "security-attention" + C["reset"])
    if state == "work-in-progress":
        return s(C["yellow"] + "work-in-progress" + C["reset"])
    if state == "needs-cleanup":
        return s(C["yellow"] + "needs-cleanup" + C["reset"])
    return s(C["yellow"] + state + C["reset"])

def logo() -> None:
    code, out = run([sys.executable, str(LOGO)], timeout=3)
    if code == 0 and out:
        print(out)
    else:
        print(s(C["bold"] + C["lav"] + "OVAV" + C["reset"]))

def recommendations(model: dict[str, object]) -> list[tuple[str, str]]:
    if int(model["security"]["payload_hits"]) > 0 or bool(model["pycache"]):
        return [("Clean generated noise", "remove bytecode/cache before export"), ("Security check", "payload scan"), ("Check health", "run diagnostics after cleanup"), ("Recovery", "backup · rollback · uninstall")]
    if not bool(model["opencode_ready"]):
        return [("Setup workspace", "detect requirements and prepare surfaces"), ("Sync surfaces", "restore repo-local runtime shape"), ("Check health", "diagnostics + validators"), ("Recovery", "backup · rollback · uninstall")]
    if bool(model["dirty"]):
        return [("Review changes", "inspect current diff before continuing"), ("Check health", "diagnostics + validators"), ("Sync surfaces", "repo-local runtime check"), ("Recovery", "backup · rollback · uninstall")]
    return [("Start workspace", "OpenCode service areas"), ("Sync surfaces", "repo-local runtime check"), ("Check health", "diagnostics + validators"), ("Review capabilities", "active · gated · blocked"), ("Recovery", "backup · rollback · uninstall")]

def print_recommendations(model: dict[str, object]) -> None:
    print(s(C["bold"] + "Recommended" + C["reset"]))
    for idx, item in enumerate(recommendations(model), 1):
        title, note = item
        print(f"  {idx:<2} {title:<22} {note}")

def print_flow(title: str, steps: list[tuple[str, str]]) -> None:
    print(s(C["bold"] + title + C["reset"]))
    for index, item in enumerate(steps, 1):
        name, note = item
        print(f"  {index}. {name:<20} {note}")

def print_guardrail() -> None:
    print("")
    print(s(C["sub"] + "Guardrail: check-only by default · consent for writes · rollback before apply" + C["reset"]))

def home() -> int:
    m = status_model()
    score, total = readiness_score(m)
    logo()
    print(s(C["bold"] + "Home" + C["reset"]))
    print(f"  State       {state_label(m)}")
    print(f"  Mode        {m['mode']}")
    print(f"  Branch      {m['branch']}" + (" · dirty" if m["dirty"] else " · clean"))
    print(f"  Workspace   {mark(bool(m['opencode_ready']))} · {m['agents']} agents · {m['commands']} commands · {m['skills']} skills")
    print(f"  Security    payload {m['security']['payload_hits']}")
    print(f"  Readiness   {score}/{total} checks")
    print("")
    print_recommendations(m)
    print("")
    print(s(C["sub"] + "Type: setup · sync · workspace · capabilities · recovery · security · update · advanced" + C["reset"]))
    return 0

def setup() -> int:
    m = status_model()
    deps = m["dependencies"]
    logo()
    print(s(C["bold"] + "Setup" + C["reset"]))
    print(f"  State       {state_label(m)}")
    print("")
    print("Preflight")
    print(f"  python3              {mark(bool(deps['python3']))}")
    print(f"  git                  {mark(bool(deps['git']))}")
    print(f"  rg                   {mark(bool(deps['rg']))}")
    print(f"  opencode             {mark(bool(deps['opencode']))}")
    print(f"  workspace            {mark(bool(m['opencode_ready']))}")
    print("")
    print_flow("Automated flow", [("Detect", "dependencies, OpenCode surfaces, release files"), ("Plan artifact", "write .ovav/runtime/plans/setup-plan.json"), ("Backup", "required before apply"), ("Apply", "explicit consent only"), ("Verify", "validators + cockpit smoke")])
    print_guardrail()
    return 0

def sync() -> int:
    m = status_model()
    surfaces = m["managed_surfaces"]
    logo()
    print(s(C["bold"] + "Sync" + C["reset"]))
    print(f"  State       {state_label(m)}")
    print("  Mode        real check-only surface scan")
    print("")
    print("Surfaces")
    for name, ok in surfaces.items():
        print(f"  {name:<20} {mark(bool(ok))}")
    print("")
    drift = "clean" if all(bool(ok) for ok in surfaces.values()) and not m["pycache"] else "attention"
    print(f"  Drift       {drift}")
    print("")
    print_flow("Automated flow", [("Detect drift", "agents, commands, skills, validators"), ("Plan artifact", "write .ovav/runtime/plans/<type>-plan.json"), ("Backup", "before any managed write"), ("Apply", "requires consent"), ("Verify", "validate + smoke")])
    print_guardrail()
    return 0

def workspace() -> int:
    m = status_model()
    logo()
    print(s(C["bold"] + "Workspace" + C["reset"]))
    print(f"  State       {state_label(m)}")
    print(f"  OpenCode    {mark(bool(m['opencode_ready']))}")
    print(f"  Service     {m['agents']} agents · {m['commands']} commands · {m['skills']} skills")
    print("")
    print("Start")
    print("  Open this repository in OpenCode")
    print("  Use Platform Engineering or Research Intelligence")
    print("")
    print("Maintain")
    print("  sync")
    print("  validate")
    return 0

def capabilities() -> int:
    if not _is_dev():
        print("OVAV: internal surface — set OVAV_DEV=1")
        return 1
    logo()
    print(s(C["bold"] + "Capabilities" + C["reset"]))
    print("")
    print(s(C["green"] + "Active" + C["reset"]))
    print("  OpenCode repo-local      service areas · commands · skills")
    print("  Real check-only scans    setup · sync · security · recovery")
    print("  Plan artifacts           setup · sync · security · recovery · update")
    print("  Validation gates         source-local checks")
    print("  Cockpit intelligence     state-aware recommendations")
    print("")
    print(s(C["yellow"] + "Gated" + C["reset"]))
    print("  Source-local apply       requires explicit consent")
    print("  Updates                  review → backup → sync → validate")
    print("")
    print(s(C["red"] + "Blocked / not default" + C["reset"]))
    print("  Global config writes")
    print("  Plugin install")
    print("  Live Engram memory")
    print("  MCP / A2A")
    print("  production/global-ready claims")
    return 0

def security() -> int:
    if not _is_dev():
        print("OVAV: internal surface — set OVAV_DEV=1")
        return 1
    m = status_model()
    secrets = []  # Removed — SEGURIDAD FASE A
    payload = payload_hits()
    logo()
    print(s(C["bold"] + "Security" + C["reset"]))
    print(f"  State       {state_label(m)}")
    print("")
    print("Real checks")
    print(f"  Payload scan         {mark(len(payload) == 0)} · {len(payload)} hits")
    print("  Blocked surfaces     global config · plugin install · live Engram · MCP/A2A")
    print("")
    if payload:
        print(f"  Payload scan:         {len(payload)} issue(s) found")
    if not secrets and not payload:
        print(s(C["green"] + "Clean" + C["reset"]))
        print("  No payload files detected.")
    print_guardrail()
    return 0

def recovery() -> int:
    backup_dir = ROOT / ".ovav" / "backups"
    snapshots_dir = ROOT / ".ovav" / "snapshots"
    backups = count_files(".ovav/backups") if backup_dir.exists() else 0
    snapshots = count_files(".ovav/snapshots") if snapshots_dir.exists() else 0
    logo()
    print(s(C["bold"] + "Recovery" + C["reset"]))
    print("  Managed recovery only. User-owned files are not removed.")
    print("")
    print("State")
    print(f"  backups              {backups}")
    print(f"  snapshots            {snapshots}")
    print("")
    print_flow("Automated flow", [("Preview scope", "show managed surfaces"), ("Backup", "required before destructive write"), ("Rollback", "restore managed source-local state"), ("Uninstall", "managed surfaces only"), ("Verify", "health checks after recovery")])
    print_guardrail()
    return 0

def update() -> int:
    logo()
    print(s(C["bold"] + "Update" + C["reset"]))
    print(f"  Remote      {'available' if git_remote_present() else 'not configured'}")
    print("  Mode        check-only")
    print("")
    print_flow("Automated flow when remote exists", [("Check version", "local vs remote"), ("Review changes", "release notes/changelog"), ("Backup", "managed state snapshot"), ("Update", "explicit consent only"), ("Sync", "repo-local runtime surfaces"), ("Validate", "gates + cockpit smoke")])
    print_guardrail()
    return 0

def advanced() -> int:
    if not _is_dev():
        print("OVAV: internal surface — set OVAV_DEV=1")
        return 1
    logo()
    print(s(C["bold"] + "Advanced" + C["reset"]))
    print("  Maintainer shortcuts")
    print("    build")
    print("    segment")
    print("    memory")
    print("    model-route")
    print("    ledger")
    print("    next")
    print("")
    print("  Normal users should start with Home, Setup, Workspace, Recovery.")
    return 0

SCREENS = {
    "home": home,
    "setup": setup,
    "sync": sync,
    "workspace": workspace,
    "capabilities": capabilities,
    "security": security,
    "recovery": recovery,
    "update": update,
    "advanced": advanced,
}

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="OVAV cockpit")
    parser.add_argument("--screen", choices=sorted(SCREENS), default="home")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--validate", action="store_true", help="Run validation probe and return JSON.")
    args = parser.parse_args(argv)

    if args.validate:
        print(json.dumps(validate_probe(), indent=2))
        return 0
    if args.json:
        print(json.dumps(status_model(), indent=2))
        return 0
    return SCREENS[args.screen]()

if __name__ == "__main__":
    raise SystemExit(main())
