    "ovav_text": "#ebdbb2",
    "ovav_text_secondary": "#bdae93",
    "ovav_text_muted": "#7c6f64",
    "ovav_syn_keyword": "#d3869b",
    "ovav_syn_string": "#b8bb26",
    "ovav_syn_comment": "#7c6f64",
    "ovav_syn_function": "#83a598",
    "ovav_syn_type": "#fabd2f",
