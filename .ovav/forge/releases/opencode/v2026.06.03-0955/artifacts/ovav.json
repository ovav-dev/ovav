    "secondary": {
      "dark": "ovav_green",
      "light": "ovav_green"
    },
    "accent": {
      "dark": "ovav_rose",
      "light": "ovav_rose"
    },
    "error": {
      "dark": "ovav_error",
      "light": "ovav_error"
    },
    "warning": {
      "dark": "ovav_warning",
      "light": "ovav_warning"
    },
    "success": {
      "dark": "ovav_success",
      "light": "ovav_success"
    },
    "info": {
      "dark": "ovav_info",
      "light": "ovav_info"
    },
    "text": {
      "dark": "ovav_text",
      "light": "ovav_bg"
    },
    "textMuted": {
      "dark": "ovav_text_muted",
      "light": "ovav_text_muted"
    },
    "background": {
      "dark": "ovav_bg",
      "light": "ovav_text"
    },
    "backgroundPanel": {
      "dark": "ovav_panel",
      "light": "ovav_panel"
    },
    "backgroundElement": {
      "dark": "ovav_element",
      "light": "ovav_element"
    },
    "border": {
      "dark": "ovav_border",
      "light": "ovav_border"
    },
    "borderActive": {
      "dark": "ovav_teal",
      "light": "ovav_blue"
