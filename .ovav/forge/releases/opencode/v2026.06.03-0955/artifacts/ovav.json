      "dark": "ovav_diff_added",
      "light": "ovav_diff_added"
    },
    "diffRemoved": {
      "dark": "ovav_diff_removed",
      "light": "ovav_diff_removed"
    },
    "diffContext": {
      "dark": "ovav_diff_context",
      "light": "ovav_diff_context"
    },
    "diffHunkHeader": {
      "dark": "ovav_blue",
      "light": "ovav_blue"
    },
    "diffHighlightAdded": {
      "dark": "ovav_diff_added",
      "light": "ovav_diff_added"
    },
    "diffHighlightRemoved": {
      "dark": "ovav_diff_removed",
      "light": "ovav_diff_removed"
    }
