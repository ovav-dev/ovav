{
  "$schema": "https://opencode.ai/theme.json",
  "name": "OVAV",
  "defs": {
    "ovav_teal": "#83a598",
    "ovav_green": "#b8bb26",
    "ovav_blue": "#458588",
    "ovav_rose": "#d3869b",
    "ovav_success": "#a3be8c",
    "ovav_error": "#bf616a",
    "ovav_warning": "#d08770",
    "ovav_info": "#81a1c1",
    "ovav_bg": "#1d2021",
    "ovav_panel": "#282828",
