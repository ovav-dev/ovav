{
  "$schema": "https://opencode.ai/config.json",
  "username": "Alexander Salvador",
  "model": "openai/gpt-5.5",
  "small_model": "opencode/deepseek-v4-flash-free",
  "default_agent": "ovav-platform-engineering",
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "ovav-platform-engineering": {
      "model": "openai/gpt-5.5",
      "mode": "all",
      "color": "#83a598",
      "steps": 50
    },
    "ovav-research-intelligence": {
      "model": "openai/gpt-5.5",
      "mode": "all",
      "color": "#b8bb26",
      "steps": 30
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "sudo *": "deny",
      "gh auth token*": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git branch -D *": "deny",
      "git branch -d *": "deny"
    }
  }
}
