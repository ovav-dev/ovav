{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovav.dev/schemas/capability_lifecycle.schema.json",
  "title": "OVAV Capability Lifecycle Schema",
  "description": "Schema for capability_registry.yaml entries. Validates lifecycle state, required fields, and transition integrity.",
  "type": "object",
  "required": ["schema", "generated_at", "capabilities"],
  "properties": {
    "schema": {
      "type": "string",
      "description": "Schema version identifier",
      "const": "capability_registry.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this registry was generated"
    },
    "canonical_source": {
      "type": "string",
      "description": "Path to the canonical source document"
    },
    "total_capabilities": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of registered capabilities"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability_entry" },
      "description": "Registered OVAV capabilities with lifecycle state"
    }
  },
  "$defs": {
    "capability_entry": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "risk",
        "current_state",
        "entry_gate",
        "exit_gate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique capability identifier (e.g., CAP-SAFETY-001)",
          "pattern": "^CAP-[A-Z]+-\\d{3}$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable capability name"
        },
        "owner": {
          "type": "string",
          "description": "Owner service area or operator (e.g., platform_engineering, research_intelligence)",
          "enum": ["platform_engineering", "research_intelligence", "shared"]
        },
        "risk": {
          "type": "string",
          "description": "Risk classification of this capability",
          "enum": ["low", "medium", "high", "critical"]
        },
        "current_state": {
          "type": "string",
          "description": "Current lifecycle state",
          "enum": [
            "idea",
            "spec",
            "sandbox",
            "read_only",
            "gated_write",
            "limited_active",
            "full_active",
            "deprecated",
            "retired"
          ]
        },
        "entry_gate": {
          "type": "string",
          "description": "Gate that was passed to enter the current state"
        },
        "exit_gate": {
          "type": "string",
          "description": "Gate required to exit the current state to the next"
        },
        "rollback": {
          "type": "string",
          "description": "Rollback plan or path to rollback document",
          "default": "not_required"
        },
        "validator": {
          "type": ["string", "null"],
          "description": "Harness or validator that checks this capability"
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence artifacts proving current state is valid"
        },
        "activation_trigger": {
          "type": "string",
          "description": "What triggers this capability to activate"
        },
        "deactivation_trigger": {
          "type": ["string", "null"],
          "description": "What triggers this capability to deactivate or downgrade"
        },
        "state_history": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/state_transition_record" },
          "description": "Ordered history of state transitions for auditing"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Categorization tags"
        },
        "last_validated": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of last validation"
        },
        "notes": {
          "type": ["string", "null"],
          "description": "Additional notes or context"
        }
      }
    },
    "state_transition_record": {
      "type": "object",
      "required": ["from_state", "to_state", "gate", "timestamp"],
      "properties": {
        "from_state": {
          "type": ["string", "null"],
          "description": "Previous state (null for initial creation)"
        },
        "to_state": {
          "type": "string",
          "description": "New state"
        },
        "gate": {
          "type": "string",
          "description": "Gate that was satisfied for this transition"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When this transition occurred"
        },
        "approved_by": {
          "type": "string",
          "description": "Who approved this transition"
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence for this specific transition"
        }
      }
    }
  }
}
