{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovav.dev/schemas/observability_engine.schema.json",
  "title": "OVAV Observability Engine Trace Event",
  "description": "Schema for validating OVAV trace events generated by the observability engine.",
  "type": "object",
  "required": [
    "trace_id",
    "timestamp",
    "service_area",
    "lead",
    "mode",
    "event_type",
    "delivery_contract"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "Unique trace identifier (SHA256 digest, 12 hex chars)",
      "pattern": "^trace_[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp with timezone",
      "format": "date-time"
    },
    "service_area": {
      "type": "string",
      "description": "OVAV service area that generated the trace",
      "enum": ["platform_engineering", "research_intelligence"]
    },
    "lead": {
      "type": "string",
      "description": "Lead operator for the service area",
      "enum": ["thavren", "eidren"]
    },
    "mode": {
      "type": "string",
      "description": "Operational mode at trace time",
      "enum": [
        "default",
        "repo_local_engineering",
        "repo_local_research",
        "install_planning",
        "release_prep",
        "recovery"
      ]
    },
    "event_type": {
      "type": "string",
      "description": "Type of event being traced",
      "enum": [
        "decision",
        "context.request",
        "tool.request",
        "delegation",
        "handoff",
        "capsule_lifecycle",
        "safe_stop"
      ]
    },
    "decision": {
      "type": "string",
      "description": "Decision outcome for this event",
      "enum": ["allow", "deny", "requires_permission", "warn", "block", "pending"]
    },
    "decision_packet": {
      "type": "object",
      "description": "Structured decision metadata (from contract)",
      "properties": {
        "reason": { "type": "string" },
        "evidence": { "type": "string" },
        "gateway": { "type": "string" }
      }
    },
    "source_requests": {
      "type": "array",
      "description": "Context source requests logged during this trace",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "context_class": { "type": "string" },
          "decision": { "type": "string" }
        }
      }
    },
    "context_decisions": {
      "type": "array",
      "description": "Context gateway decisions made during this trace",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" },
          "decision": { "type": "string" }
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "description": "Tool gateway calls logged during this trace",
      "items": {
        "type": "object",
        "properties": {
          "tool": { "type": "string" },
          "parameters_sanitized": { "type": "boolean" }
        }
      }
    },
    "handoffs": {
      "type": "array",
      "description": "Delegation handoffs performed during this trace",
      "items": {
        "type": "object",
        "properties": {
          "target": { "type": "string" },
          "sanitized": { "type": "boolean" }
        }
      }
    },
    "model_used": {
      "type": "string",
      "description": "Model body used for this trace",
      "default": "not_selected"
    },
    "token_usage_estimate": {
      "type": "integer",
      "description": "Estimated token usage for this trace event",
      "minimum": 0
    },
    "cost_estimate": {
      "type": "number",
      "description": "Estimated cost in USD for this trace event",
      "minimum": 0
    },
    "evals_passed": {
      "type": "array",
      "description": "Evaluations that passed for this trace",
      "items": { "type": "string" }
    },
    "evals_failed": {
      "type": "array",
      "description": "Evaluations that failed for this trace",
      "items": { "type": "string" }
    },
    "delivery_contract": {
      "type": "string",
      "description": "Delivery contract that governed this trace",
      "enum": [
        "consultation",
        "implementation_delivery",
        "compact_summary",
        "safe_stop_report",
        "handoff_delivery"
      ]
    },
    "capsule_id": {
      "type": "string",
      "description": "Session capsule ID associated with this trace",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sanitized": {
      "type": "boolean",
      "description": "Whether the trace has been sanitized of secrets",
      "default": false
    },
    "evidence_written": {
      "type": "boolean",
      "description": "Whether evidence file was written to disk",
      "default": false
    },
    "evidence_path": {
      "type": "string",
      "description": "Path to written evidence file, if any"
    }
  }
}
