{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovav.dev/schemas/capability_score.schema.json",
  "title": "OVAV Capability Score Schema",
  "description": "Schema for capability_scores.yaml. Validates scoring methodology, individual scores, and aggregate metrics.",
  "type": "object",
  "required": ["schema", "generated_at", "total_scored", "scores", "aggregates"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "capability_scores.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "canonical_source": {
      "type": "string"
    },
    "total_scored": {
      "type": "integer",
      "minimum": 0
    },
    "scoring_version": {
      "type": "string"
    },
    "scoring_methodology": {
      "type": "object",
      "required": ["value_score_formula", "thresholds"],
      "properties": {
        "value_score_formula": {
          "type": "object",
          "required": [
            "success_rate_weight",
            "usage_relevance_weight",
            "risk_alignment_weight",
            "maintenance_efficiency_weight",
            "evidence_quality_weight",
            "incident_penalty_per_incident"
          ],
          "properties": {
            "success_rate_weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "usage_relevance_weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "risk_alignment_weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "maintenance_efficiency_weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidence_quality_weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "incident_penalty_per_incident": { "type": "number", "minimum": 0 }
          }
        },
        "thresholds": {
          "type": "object",
          "required": ["healthy_min", "needs_attention_min", "degraded_below"],
          "properties": {
            "healthy_min": { "type": "integer", "minimum": 0, "maximum": 100 },
            "needs_attention_min": { "type": "integer", "minimum": 0, "maximum": 100 },
            "degraded_below": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "scores": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability_score_entry" }
    },
    "aggregates": {
      "type": "object",
      "required": [
        "total_scored",
        "by_decision",
        "by_status",
        "by_type",
        "average_value_score",
        "total_risk_incidents"
      ],
      "properties": {
        "total_scored": { "type": "integer" },
        "by_decision": {
          "type": "object",
          "required": ["keep", "improve", "degrade", "retire"],
          "properties": {
            "keep": { "type": "integer", "minimum": 0 },
            "improve": { "type": "integer", "minimum": 0 },
            "degrade": { "type": "integer", "minimum": 0 },
            "retire": { "type": "integer", "minimum": 0 }
          }
        },
        "by_status": {
          "type": "object",
          "required": ["healthy", "needs_attention", "degraded", "unknown"],
          "properties": {
            "healthy": { "type": "integer", "minimum": 0 },
            "needs_attention": { "type": "integer", "minimum": 0 },
            "degraded": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          }
        },
        "by_type": {
          "type": "object"
        },
        "average_value_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "total_risk_incidents": { "type": "integer", "minimum": 0 },
        "capabilities_never_used": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "capability_score_entry": {
      "type": "object",
      "required": [
        "id",
        "type",
        "owner",
        "usage_count",
        "risk_incidents",
        "last_validated",
        "value_score",
        "maintenance_status",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CAP-[A-Z]+-\\d{3}$"
        },
        "type": {
          "type": "string",
          "enum": ["skill", "harness", "squad", "tool", "policy", "validator"]
        },
        "owner": {
          "type": "string",
          "enum": ["platform_engineering", "research_intelligence", "shared"]
        },
        "usage_count": {
          "type": "integer",
          "minimum": 0
        },
        "success_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "failure_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "avg_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "avg_time_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "risk_incidents": {
          "type": "integer",
          "minimum": 0
        },
        "last_validated": {
          "type": "string",
          "format": "date-time"
        },
        "value_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maintenance_status": {
          "type": "string",
          "enum": ["healthy", "needs_attention", "degraded", "unknown"]
        },
        "decision": {
          "type": "string",
          "enum": ["keep", "improve", "degrade", "retire"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
